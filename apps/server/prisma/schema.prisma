generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Product agents available in the workspace.
enum Agent {
  MAYA
  SAGE
  LEX
  REX
  SCOUT
  VEGA
}

/// Social publishing destinations supported by Maya.
enum SocialPlatform {
  TWITTER
  LINKEDIN
  INSTAGRAM
}

/// Lifecycle of an org's connection to a Composio-hosted MCP toolkit.
enum McpConnectionStatus {
  PENDING
  AUTH_REQUIRED
  CONNECTED
  ERROR
  DISCONNECTED
}

/// Which provider brokers an McpConnection row. Composio brokers the whole
/// catalog. (Instagram publishes via a native Meta Graph API provider, not MCP.)
enum McpProvider {
  COMPOSIO
}

/// Lifecycle of a staged write-capable MCP tool call awaiting user confirmation.
enum McpPendingActionStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXECUTED
  FAILED
}

/// Where a staged action came from. CHAT actions were proposed inside a
/// conversation the user was present for; TRIGGER actions were proposed by an
/// inbound provider event while nobody was watching, so the UI must present
/// them differently — the user has no surrounding context for them.
enum McpActionSource {
  CHAT
  TRIGGER
}

/// What happens when an agent proposes a write.
enum McpApprovalMode {
  /// Stage it and wait for a human. The default, and the only safe default.
  ALWAYS_ASK
  /// Run it immediately, no approval. Still recorded in the action log.
  AUTO_RUN
  /// Refuse it outright. Recorded as rejected so the attempt stays visible.
  NEVER
}

/// Processing state of one inbound provider event.
enum McpTriggerEventStatus {
  /// Accepted and acknowledged to the provider; not yet handled.
  RECEIVED
  /// Handled — the agent ran and any proposed actions were staged.
  PROCESSED
  /// Deliberately not handled (subscription disabled, loop guard, no payload).
  SKIPPED
  /// Handling threw. Not retried automatically; `error` holds the reason.
  FAILED
}

/// Local entitlement state mirrored from the billing provider.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Paid subscription cadence.
enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

/// Billing entitlement shape.
enum SubscriptionEntitlementMode {
  CUSTOM
}

/// Where an entitlement came from.
enum EntitlementSource {
  TRIAL
  AGENT
}

/// Lifecycle of a single agent entitlement.
enum EntitlementStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  SUPERSEDED
}

/// Task type: agent-automated vs user-defined general task.
enum TaskType {
  AGENT
  GENERAL
}

/// Vega follow-up lifecycle.
enum FollowUpStatus {
  PENDING
  SENT
  CANCELLED
  OVERDUE
}

/// Cached Vega briefing cadence.
enum BriefingType {
  MORNING
  EVENING
  WEEKLY
}

/// Notable end-user action types surfaced in the admin activity feed.
enum ActivityAction {
  LOGIN
  PUBLISHED_POST
  GENERATED_VIDEO
  GENERATED_STORYBOARD
  CREDITS_USED
}

/// Better Auth user plus admin flags.
model User {
  /// Better Auth user id.
  id                 String              @id
  /// Display name shown in the app.
  name               String
  /// Login email and unique user identifier.
  email              String
  /// Whether the email address has been verified.
  emailVerified      Boolean             @default(false)
  /// Optional profile image URL from the auth provider.
  image              String?
  /// User creation timestamp.
  createdAt          DateTime            @default(now())
  /// User update timestamp maintained by Prisma.
  updatedAt          DateTime            @updatedAt
  /// Optional app/admin role.
  role               String?
  /// Better Auth ban flag.
  banned             Boolean?            @default(false)
  /// Optional ban reason visible to admins.
  banReason          String?
  /// Optional ban expiry timestamp.
  banExpires         DateTime?
  /// Auth sessions owned by this user.
  sessions           Session[]
  /// OAuth/password accounts linked to this user.
  accounts           Account[]
  /// Organization memberships for this user.
  members            Member[]
  /// Organization invitations sent by this user.
  invitations        Invitation[]
  /// Feedback posts authored by this user.
  feedbackPosts      FeedbackPost[]      @relation("FeedbackPostAuthor")
  /// Upvotes cast by this user on feedback posts.
  feedbackVotes      FeedbackVote[]      @relation("FeedbackVoteUser")
  /// Comments left by this user on feedback posts.
  feedbackComments   FeedbackComment[]   @relation("FeedbackCommentUser")
  /// Upvotes cast by this user on upcoming agents.
  upcomingAgentVotes UpcomingAgentVote[] @relation("UpcomingAgentVoteUser")
  /// Activity log entries recorded for this user.
  activityLogs       ActivityLog[]

  @@unique([email])
  @@map("user")
}

/// Better Auth session.
model Session {
  /// Better Auth session id.
  id                   String   @id
  /// Session expiry timestamp.
  expiresAt            DateTime
  /// Unique bearer session token.
  token                String
  /// Session creation timestamp.
  createdAt            DateTime @default(now())
  /// Session update timestamp.
  updatedAt            DateTime @updatedAt
  /// Last known client IP.
  ipAddress            String?
  /// Last known user agent string.
  userAgent            String?
  /// Owning user id.
  userId               String
  /// Owning user relation.
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Admin impersonator id when impersonation is active.
  impersonatedBy       String?
  /// Organization currently selected in the UI.
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// Better Auth account/provider credentials.
model Account {
  /// Better Auth account row id.
  id                    String    @id
  /// Provider account id, such as Google subject id.
  accountId             String
  /// Provider name, such as google.
  providerId            String
  /// Owning user id.
  userId                String
  /// Owning user relation.
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OAuth access token used for provider APIs.
  accessToken           String?
  /// OAuth refresh token used to refresh access.
  refreshToken          String?
  /// OAuth/OIDC id token.
  idToken               String?
  /// Access token expiry timestamp.
  accessTokenExpiresAt  DateTime?
  /// Refresh token expiry timestamp.
  refreshTokenExpiresAt DateTime?
  /// OAuth scope string granted by the provider.
  scope                 String?
  /// Password hash for credential auth, when used.
  password              String?
  /// Account creation timestamp.
  createdAt             DateTime  @default(now())
  /// Account update timestamp.
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([userId, providerId, updatedAt])
  @@index([providerId, userId])
  @@map("account")
}

/// Better Auth verification token.
model Verification {
  /// Verification row id.
  id         String   @id
  /// Verification target, usually email or token namespace.
  identifier String
  /// Verification secret/value.
  value      String
  /// Expiry timestamp.
  expiresAt  DateTime
  /// Creation timestamp.
  createdAt  DateTime @default(now())
  /// Update timestamp.
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Tenant organization and denormalized entitlement state.
model Organization {
  /// Better Auth organization id.
  id                   String                @id
  /// Organization display name.
  name                 String
  /// Unique URL/workspace slug.
  slug                 String
  /// Optional organization logo URL.
  logo                 String?
  /// Organization creation timestamp.
  createdAt            DateTime
  /// Better Auth metadata blob stored as string.
  metadata             String?
  /// Whether onboarding/brand kit setup is complete.
  onboarded            Boolean               @default(false)
  /// Opt-in to the planner + DAG run engine. Off means every turn takes the
  /// existing single-pass path, so the feature can be rolled out per org.
  plannedRunsEnabled   Boolean               @default(false)
  /// Users belonging to this organization.
  members              Member[]
  /// Pending invitations for this organization.
  invitations          Invitation[]
  /// Fast entitlement status used by middleware.
  subscriptionStatus   SubscriptionStatus?
  /// Fast entitlement expiry used by middleware.
  entitlementExpiresAt DateTime?
  /// Fast per-agent unlocks used by middleware.
  unlockedAgents       Agent[]               @default([])
  /// When the org's one-and-only trial was started. Non-null = trial already used.
  trialStartedAt       DateTime?
  /// Per-agent entitlements — the source of truth for access.
  entitlements         Entitlement[]
  /// Dodo subscriptions billing this org.
  billingSubscriptions BillingSubscription[]
  /// Source billing subscription row.
  subscription         Subscription?
  /// Per-agent memory summaries.
  agentMemory          AgentMemory[]
  /// Organization-wide memory summary.
  orgMemory            OrgMemory?
  /// Scheduled tasks owned by this organization.
  tasks                Task[]
  /// Maya per-billing-period usage records.
  mayaUsages           MayaUsage[]
  /// Checkout sessions awaiting provider confirmation.
  pendingCheckouts     PendingCheckout[]

  @@unique([slug])
  @@index([subscriptionStatus])
  @@index([createdAt])
  @@index([subscriptionStatus, entitlementExpiresAt])
  @@map("organization")
}

/// Billing provider subscription record for one organization.
model Subscription {
  /// Local subscription id.
  id                       String                       @id @default(cuid())
  /// Owning organization id.
  organizationId           String                       @unique
  /// Owning organization relation.
  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Dodo customer id.
  dodoCustomerId           String                       @unique
  /// Dodo subscription id after checkout activation.
  dodoSubscriptionId       String?                      @unique
  /// Current local billing status.
  status                   SubscriptionStatus           @default(TRIALING)
  /// Current paid plan cadence.
  plan                     SubscriptionPlan?
  /// Legacy entitlement-shape field. The enum now has only one value
  /// (CUSTOM) — access is fully governed by Entitlement rows, not this mode.
  entitlementMode          SubscriptionEntitlementMode  @default(CUSTOM)
  /// Legacy/vestigial: written on customer creation but not read by any
  /// access-control or provisioning logic. Real agent access lives on
  /// Entitlement rows; this column predates that and is kept only to avoid
  /// a migration.
  selectedAgents           Agent[]                      @default([])
  /// Checkout session waiting for provider confirmation.
  pendingCheckoutSessionId String?
  /// Pending paid plan cadence from latest checkout.
  pendingPlan              SubscriptionPlan?
  /// Pending entitlement mode from latest checkout.
  pendingEntitlementMode   SubscriptionEntitlementMode?
  /// Pending selected agents from latest checkout.
  pendingSelectedAgents    Agent[]                      @default([])
  /// Pending Dodo product id from latest checkout.
  pendingProductId         String?
  /// Pending checkout creation timestamp.
  pendingCheckoutCreatedAt DateTime?
  /// Trial end timestamp.
  trialEndsAt              DateTime?
  /// Current paid period end timestamp.
  currentPeriodEnd         DateTime?
  /// Whether cancellation is scheduled for period end.
  cancelAtPeriodEnd        Boolean                      @default(false)
  /// Subscription creation timestamp.
  createdAt                DateTime                     @default(now())
  /// Subscription update timestamp.
  updatedAt                DateTime                     @updatedAt

  @@map("subscription")
}

/// Source of truth for agent access. One row per purchase of one agent.
/// Deliberately NOT unique on [organizationId, agent]: overlapping rows are
/// legal and load-bearing (e.g. a TRIAL row and an AGENT row for the same
/// agent both exist briefly while a trialing org converts to paid).
model Entitlement {
  /// Entitlement row id.
  id                    String               @id @default(cuid())
  /// Owning organization id.
  organizationId        String
  /// Owning organization relation.
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Agent this entitlement grants access to.
  agent                 Agent
  /// Where this entitlement came from.
  source                EntitlementSource
  /// Current lifecycle status.
  status                EntitlementStatus
  /// Inclusive start of the current billing period.
  currentPeriodStart    DateTime
  /// End of the current billing period.
  currentPeriodEnd      DateTime
  /// Whether cancellation is scheduled for period end.
  cancelAtPeriodEnd     Boolean              @default(false)
  /// Cents actually paid for this agent — the price paid, not today's list
  /// price.
  priceCents            Int                  @default(0)
  /// Owning Dodo subscription id, if any.
  billingSubscriptionId String?
  /// Owning Dodo subscription relation.
  billingSubscription   BillingSubscription? @relation(fields: [billingSubscriptionId], references: [id], onDelete: SetNull)
  /// Creation timestamp.
  createdAt             DateTime             @default(now())
  /// Update timestamp.
  updatedAt             DateTime             @updatedAt

  /// Hot path: the access check.
  @@index([organizationId, agent, currentPeriodEnd])
  /// Sweeper: find lapsed rows.
  @@index([currentPeriodEnd, status])
  @@index([billingSubscriptionId])
  @@map("entitlement")
}

/// One row per Dodo subscription. Bills 1..N entitlements.
model BillingSubscription {
  /// Local billing subscription id.
  id                 String             @id @default(cuid())
  /// Owning organization id.
  organizationId     String
  /// Owning organization relation.
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Dodo subscription id.
  dodoSubscriptionId String             @unique
  /// Paid plan cadence.
  plan               SubscriptionPlan
  /// Current local billing status.
  status             SubscriptionStatus
  /// Current paid period end timestamp.
  currentPeriodEnd   DateTime
  /// Whether cancellation is scheduled for period end.
  cancelAtPeriodEnd  Boolean            @default(false)
  /// Entitlements billed by this subscription.
  entitlements       Entitlement[]
  /// Creation timestamp.
  createdAt          DateTime           @default(now())
  /// Update timestamp.
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
  @@map("billing_subscription")
}

/// Kind of checkout a PendingCheckout row is waiting on.
enum CheckoutKind {
  AGENT
  /// One-time Maya credit top-up purchase (not a subscription).
  MAYA_TOPUP
}

/// A checkout awaiting provider confirmation. Replaces Subscription.pending*.
/// Holds a SINGLE agent: Dodo permits one subscription per checkout.
model PendingCheckout {
  /// Pending checkout row id.
  id             String           @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// Owning organization relation.
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Dodo checkout session id.
  sessionId      String           @unique
  /// What this checkout is for.
  kind           CheckoutKind
  /// Agent being purchased. Null for MAYA_TOPUP.
  agent          Agent?
  /// Billing cadence for this checkout. Meaningless filler ("MONTHLY") for
  /// MAYA_TOPUP, which has no cadence — kept non-null for schema simplicity,
  /// same convention as individual-agent checkouts.
  plan           SubscriptionPlan
  /// Optional discount code applied at checkout.
  discountCode   String?
  /// Credits purchased. Only set for MAYA_TOPUP; null otherwise.
  credits        Int?
  /// Creation timestamp.
  createdAt      DateTime         @default(now())

  // Closes the double-purchase race at the DB level: at most one in-flight
  // AGENT checkout per org+agent. MAYA_TOPUP rows are unaffected — `agent` is
  // always null for them, and Postgres never treats two NULLs as equal, so
  // this constraint imposes no limit on concurrent top-ups.
  @@unique([organizationId, agent])
  @@index([organizationId, createdAt])
  @@map("pending_checkout")
}

/// Dodo webhook event processing ledger for idempotency.
model BillingWebhookEvent {
  /// Dodo webhook event id.
  eventId        String   @id
  /// Dodo event type such as subscription.active.
  eventType      String
  /// Dodo subscription id if present.
  subscriptionId String?
  /// Owning organization id if resolved.
  organizationId String?
  /// Event processing timestamp.
  processedAt    DateTime @default(now())
  /// Compact processing result.
  result         String

  @@index([organizationId, processedAt])
  @@index([subscriptionId])
  @@map("billing_webhook_event")
}

/// Append-only log of notable end-user actions, surfaced in the admin Activity tab.
model ActivityLog {
  /// Local activity log id.
  id             String         @id @default(cuid())
  /// Acting user id.
  userId         String
  /// Acting user relation.
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Organization the action occurred in, if any.
  organizationId String?
  /// What the user did.
  action         ActivityAction
  /// Short human-readable description shown in the feed, e.g. "Published a LinkedIn post".
  summary        String
  /// Extra structured context (platform, creditsUsed, postId, etc).
  metadata       Json?
  /// Action timestamp.
  createdAt      DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("activity_log")
}

/// User membership in an organization.
model Member {
  /// Membership row id.
  id             String       @id
  /// Organization id.
  organizationId String
  /// Organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// User id.
  userId         String
  /// User relation.
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Membership role such as owner or member.
  role           String       @default("member")
  /// Membership creation timestamp.
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId, role])
  @@index([organizationId, role])
  @@map("member")
}

/// Invitation to join an organization.
model Invitation {
  /// Invitation row id.
  id             String       @id
  /// Target organization id.
  organizationId String
  /// Target organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Invitee email address.
  email          String
  /// Invited role.
  role           String?
  /// Invitation status.
  status         String       @default("pending")
  /// Expiry timestamp.
  expiresAt      DateTime
  /// Creation timestamp.
  createdAt      DateTime     @default(now())
  /// Inviting user id.
  inviterId      String
  /// Inviting user relation.
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// Organization brand profile used by all agents.
model BrandKit {
  /// Brand kit id.
  id                  String    @id @default(uuid())
  /// Owning organization id.
  organizationId      String    @unique
  /// Company display name.
  company_name        String    @default("")
  /// Short company description.
  company_description String    @default("")
  /// Primary value proposition.
  value_proposition   String    @default("")
  /// Industry or market category.
  industry            String    @default("")
  /// Target audience description.
  target_audience     String    @default("")
  /// Brand voice guidance.
  brand_voice         String    @default("")
  /// Legacy public logo URL retained for older rows/clients.
  logo_url            String?
  /// R2 key for the logo asset.
  logo_key            String?
  /// Legacy public mascot URL retained for older rows/clients.
  mascot_url          String?
  /// R2 key for the mascot asset.
  mascot_key          String?
  /// Public URL for the organization's letterhead image (used in Lex document exports).
  letterhead_url      String?
  /// R2 key for the letterhead asset.
  letterhead_key      String?
  /// Brand color tokens.
  brand_colors        Json      @default("{}")
  /// Platform-specific tone guidance.
  platform_tones      Json      @default("{}")
  /// Known competitors from onboarding.
  competitors         Json      @default("[]")
  /// Differentiation notes.
  key_differentiators String    @default("")
  /// Company website URL.
  website_url         String    @default("")
  /// Optional business location.
  location            String?
  /// Raw crawled website text.
  crawled_content     String?
  /// AI or crawler summary of website content.
  crawled_summary     String?
  /// Last crawl timestamp.
  crawled_at          DateTime?
  /// URL/source used for the last crawl.
  crawl_source        String?
  /// Creation timestamp.
  createdAt           DateTime  @default(now())
  /// Update timestamp.
  updatedAt           DateTime  @updatedAt

  @@map("brand_kit")
}

/// Extra brand images selected for Maya generation.
model BrandImage {
  /// Brand image id.
  id             String   @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// R2 object key; public URL is derived from this key.
  key            String
  /// User-facing image name.
  name           String   @default("")
  /// Creation timestamp.
  createdAt      DateTime @default(now())
  /// Update timestamp.
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@map("brand_image")
}

/// Chat message history across agents.
model Message {
  /// Message id.
  id             String             @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// Message role, usually user or assistant.
  role           String             @default("user")
  /// Message text content.
  content        String
  /// Creation timestamp.
  createdAt      DateTime           @default(now())
  /// Optional generated or attached image URL.
  imageUrl       String?
  /// Agent that owns this message.
  agent          Agent
  /// Token usage reported by the AI service.
  tokensUsed     Int                @default(0)
  /// Model identifier reported by the AI service.
  model          String?
  /// User id that initiated the message.
  userId         String?
  /// Structured action input/result metadata for cards.
  customInput    Json?
  /// True for messages in the shared team thread.
  ///
  /// A team message still carries a real `agent` (whoever led the reply), so
  /// this is what keeps it out of that agent's own conversation. Deliberately
  /// a flag rather than a TEAM member on the Agent enum: that enum drives
  /// entitlements, billing and the MCP catalog, and none of those have a
  /// meaningful answer for "the team".
  isTeam         Boolean            @default(false)
  /// Write-capable MCP tool calls this message staged for confirmation.
  pendingActions McpPendingAction[]
  /// Planned multi-step runs rendered on this message.
  runs           AgentRun[]

  @@index([agent, organizationId])
  @@index([organizationId, agent, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, role, createdAt])
  @@index([role, createdAt])
  @@index([agent, role, createdAt])
  @@index([organizationId, isTeam, createdAt])
  @@map("message")
}

/// Per-agent long-term memory summary.
model AgentMemory {
  /// Memory row id.
  id               String       @id @default(uuid())
  /// Owning organization id.
  organizationId   String
  /// Agent this memory belongs to.
  agent            Agent
  /// Running conversation summary.
  runningSummary   String       @default("") @db.Text
  /// Durable facts extracted from conversations.
  longTermFacts    Json         @default("[]")
  /// Number of messages represented in the summary.
  messageCount     Int          @default(0)
  /// Last summarization timestamp.
  lastSummarizedAt DateTime?
  /// Creation timestamp.
  createdAt        DateTime     @default(now())
  /// Update timestamp.
  updatedAt        DateTime     @updatedAt
  /// Owning organization relation.
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agent])
  @@index([organizationId])
  @@map("agent_memory")
}

/// Organization-wide shared memory.
model OrgMemory {
  /// Memory row id.
  id             String       @id @default(uuid())
  /// Owning organization id.
  organizationId String       @unique
  /// Running organization summary.
  runningSummary String       @default("") @db.Text
  /// Durable organization-level facts.
  longTermFacts  Json         @default("[]")
  /// Shared cross-agent memory payload.
  sharedMemory   Json         @default("{}")
  /// Update timestamp.
  updatedAt      DateTime     @updatedAt
  /// Owning organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_memory")
}

/// Connected social account for publishing.
model SocialAccount {
  /// Social account id.
  id                   String          @id @default(uuid())
  /// Owning organization id.
  organizationId       String
  /// User who connected the account.
  userId               String
  /// Social platform.
  platform             SocialPlatform
  /// Provider-side account id.
  providerAccountId    String
  /// Provider-side account display name.
  accountName          String?
  /// Provider access token.
  accessToken          String
  /// Provider refresh token.
  refreshToken         String?
  /// Provider access token expiry.
  accessTokenExpiresAt DateTime?
  /// Provider OAuth scopes.
  scope                String?
  /// Provider-specific metadata.
  metadata             Json?
  /// Creation timestamp.
  createdAt            DateTime        @default(now())
  /// Update timestamp.
  updatedAt            DateTime        @updatedAt
  /// Posts published through this account.
  publishedPosts       PublishedPost[]

  @@unique([organizationId, platform, providerAccountId])
  @@index([organizationId, createdAt])
  @@index([organizationId, accessTokenExpiresAt])
  @@map("social_account")
}

/// Org-level pointer to an MCP connection brokered by Composio. The provider
/// stores the actual credentials server-side (encrypted, write-only) — this
/// row is status/metadata only, never a token.
model McpConnection {
  /// Connection id.
  id                String              @id @default(uuid())
  /// Owning organization id.
  organizationId    String
  /// Catalog slug from @repo/integrations-catalog, e.g. "notion".
  integrationSlug   String
  /// Composio's real connected-account id (or connection-request id prior to
  /// OAuth completion), returned by the provider — not locally generated.
  connectionId      String              @unique
  /// Toolkit identifier in the owning provider's own namespace — Composio's
  /// toolkit slug (e.g. "gmail").
  toolkitSlug       String
  /// Which provider brokers this connection. Composio brokers the whole catalog.
  provider          McpProvider         @default(COMPOSIO)
  /// Agent whose "Onboard me" UI surfaced this connection. UX attribution
  /// only — NOT access control; tool visibility is computed from the
  /// catalog's agents[] field at request time.
  ownerAgent        Agent
  /// Connection lifecycle state.
  status            McpConnectionStatus @default(PENDING)
  /// Cached copy of the toolkit's connect-time config JSON Schema, avoids a
  /// refetch from Composio on every settings page load.
  configSchema      Json?
  /// Last time this connection reached CONNECTED.
  lastConnectedAt   DateTime?
  /// Last time status was polled/refreshed from Composio.
  lastCheckedAt     DateTime?
  /// Last error message, if status is ERROR.
  lastError         String?
  /// User who initiated the connection.
  connectedByUserId String?
  /// Creation timestamp.
  createdAt         DateTime            @default(now())
  /// Update timestamp.
  updatedAt         DateTime            @updatedAt

  @@unique([organizationId, integrationSlug])
  @@index([organizationId, status])
  @@map("mcp_connection")
}

/// A write-capable MCP tool call the LLM proposed mid-conversation, staged
/// here instead of executed immediately — requires an explicit user
/// confirm/reject click (see mcp.service.ts confirmPendingAction /
/// rejectPendingAction) before the underlying provider call actually runs.
model McpPendingAction {
  /// Pending action id — also used as the tool-call id apps/ai generated.
  id              String                 @id @default(uuid())
  /// Owning organization id.
  organizationId  String
  /// User whose conversation staged this action.
  userId          String
  /// Agent whose tool loop proposed this action.
  agent           Agent
  /// Chat message this action was staged from, if the message still exists.
  messageId       String?
  /// Owning message relation.
  message         Message?               @relation(fields: [messageId], references: [id], onDelete: SetNull)
  /// McpConnection.connectionId the tool call targets.
  connectionId    String
  /// Catalog slug, denormalized for cheap frontend display (icon/name).
  integrationSlug String
  /// Real provider-side tool/action slug (e.g. Composio's GMAIL_SEND_EMAIL).
  toolName        String
  /// Arguments the LLM proposed calling the tool with.
  arguments       Json
  /// Human-readable summary shown in the confirm/reject UI.
  summary         String
  /// Whether a human was present when this was proposed. TRIGGER actions have
  /// no messageId and no conversation to read for context.
  source          McpActionSource        @default(CHAT)
  /// Trigger event that produced this action, when source is TRIGGER.
  triggerEventId  String?
  /// Staged action lifecycle state.
  status          McpPendingActionStatus @default(PENDING)
  /// Provider result, once executed.
  resultJson      Json?
  /// Provider error, if execution failed.
  errorMessage    String?
  /// Creation timestamp.
  createdAt       DateTime               @default(now())
  /// Update timestamp.
  updatedAt       DateTime               @updatedAt

  /// Run step that proposed this write, when it came from a planned run.
  /// Also discriminates run-sourced writes from chat ones — no enum needed.
  runStepId       String?
  /// The step that proposed it.
  runStep         AgentRunStep?          @relation(fields: [runStepId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([messageId])
  @@index([runStepId])
  @@map("mcp_pending_action")
}

/// Per-(org, agent) override of which connected MCP integration an agent's
/// native tools should prefer over their built-in default data source (e.g.
/// Scout's research tools use native Serper search by default; toggling this
/// to "tavily" makes them source from the connected Tavily integration
/// instead). Deterministic override — exists because prompt-level "prefer
/// the MCP tool" guidance proved unreliable for tools that call their own
/// data source internally rather than choosing between exposed tool options.
model McpToolPreference {
  /// Preference row id.
  id                       String   @id @default(uuid())
  /// Owning organization id.
  organizationId           String
  /// Agent this preference applies to.
  agent                    Agent
  /// Catalog slug of the preferred MCP integration (e.g. "tavily"), or null
  /// to use the agent's default (native) data source.
  preferredIntegrationSlug String?
  /// Creation timestamp.
  createdAt                DateTime @default(now())
  /// Update timestamp.
  updatedAt                DateTime @updatedAt

  @@unique([organizationId, agent])
  @@map("mcp_tool_preference")
}

/// One executed MCP tool call. Written for every call that actually reaches a
/// provider — reads and writes alike — because three separate things need it
/// and none of them can be reconstructed after the fact: the customer-facing
/// audit trail, the monthly value report ("N actions across M systems"), and
/// usage metering for action-based billing. Deliberately does NOT store tool
/// arguments or results: those routinely carry the customer's own email
/// bodies and financial records, and this table is retained long-term.
model McpActionLog {
  /// Action log id.
  id              String   @id @default(uuid())
  /// Owning organization id.
  organizationId  String
  /// Agent that made the call, when it originated from an agent turn.
  agent           Agent?
  /// Catalog slug of the integration called (e.g. "gmail").
  integrationSlug String
  /// Real provider-side tool slug (e.g. "GMAIL_FETCH_EMAILS").
  toolName        String
  /// Whether the tool mutates the connected system — writes are the ones that
  /// required human approval, and the ones the value report counts.
  isWrite         Boolean  @default(false)
  /// Whether the provider call succeeded.
  successful      Boolean  @default(true)
  /// Provider round-trip duration in milliseconds.
  durationMs      Int?
  /// Creation timestamp.
  createdAt       DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, integrationSlug])
  @@map("mcp_action_log")
}

/// UNUSED — the dashboard's live tiles were removed (see CommandCenter.tsx for
/// why: one provider call per tile, against a number that rarely changed what
/// anyone did). The table is kept rather than dropped so existing rows aren't
/// destroyed on a decision that could be revisited; nothing reads it.
///
/// A metric the org chose to pin to its dashboard, e.g. "Gmail · unread" or
/// "Razorpay · customers". Exists because no heuristic can guess which of a
/// toolkit's ~60-200 read tools matters to a given business — verified
/// empirically: auto-picking the first argument-free read tool across 14 live
/// connections produced a usable figure for only 2, and chose meaningless
/// tools (DISCORD_GET_GATEWAY, TAVILY_GET_USAGE) for the rest. So the choice
/// is the customer's, made once, from a previewed shortlist.
model McpDashboardTile {
  /// Tile id.
  id              String   @id @default(uuid())
  /// Owning organization id.
  organizationId  String
  /// Widget catalog id, e.g. "gmail.unread" — see mcp.widgets.ts. The widget
  /// definition owns the tool, arguments, field mapping and formatting; the
  /// customer only ever picks a business-language name from the gallery.
  widgetId        String
  /// Catalog slug of the integration, denormalized so tiles for a
  /// disconnected system can be skipped without loading the widget catalog.
  integrationSlug String
  /// Inputs the customer supplied for this widget, e.g. {"site_url": "..."}.
  /// Never contains dates: those are relative tokens resolved per call so a
  /// tile pinned today does not report today's window forever.
  inputs          Json?
  /// Optional rename of the widget's default name, in the customer's words.
  label           String?
  /// Display order on the dashboard, ascending.
  position        Int      @default(0)
  /// Creation timestamp.
  createdAt       DateTime @default(now())
  /// Update timestamp.
  updatedAt       DateTime @updatedAt

  // Deliberately no unique constraint on (org, widgetId): the same widget with
  // different inputs is a different tile — an org with two Search Console
  // properties legitimately wants clicks for both.
  @@index([organizationId, position])
  @@map("mcp_dashboard_tile")
}

/// An inbound provider event the org has asked an agent to act on — "when a
/// new email arrives, have Vega draft a reply". The counterpart to everything
/// else in this module: every other MCP call starts with a human asking.
///
/// Composio holds the real subscription; this row is the local mirror plus the
/// policy (which agent, whose identity, enabled or not). `composioTriggerId`
/// is null between creating the row and Composio accepting it, so a failed
/// remote create leaves a visibly-broken row rather than a silent no-op.
model McpTriggerSubscription {
  /// Subscription id.
  id                String    @id @default(uuid())
  /// Owning organization id.
  organizationId    String
  /// Catalog slug, e.g. "gmail".
  integrationSlug   String
  /// McpConnection.connectionId this subscribes against.
  connectionId      String
  /// Composio's own trigger type slug, e.g. "GMAIL_NEW_GMAIL_MESSAGE".
  triggerSlug       String
  /// Composio's trigger *instance* id, returned by triggers.create(). Null
  /// until the remote subscription exists.
  composioTriggerId String?   @unique
  /// Agent that handles events from this subscription.
  agent             Agent
  /// What the agent should do when this fires. Null means use the catalog's
  /// curated instruction, or the generic one for a discovered trigger that has
  /// no curated entry.
  instruction       String?
  /// User whose identity staged actions run under. Trigger-staged actions
  /// still need an owner even though nobody clicked anything.
  createdByUserId   String
  /// Whether events are currently acted on. Disabling leaves the Composio
  /// subscription in place but drops events at the door.
  enabled           Boolean   @default(true)
  /// Last time an event arrived for this subscription.
  lastEventAt       DateTime?
  /// Last handling error, if any.
  lastError         String?
  /// Creation timestamp.
  createdAt         DateTime  @default(now())
  /// Update timestamp.
  updatedAt         DateTime  @updatedAt

  @@unique([organizationId, triggerSlug])
  @@index([organizationId, enabled])
  @@map("mcp_trigger_subscription")
}

/// One inbound event, recorded before it is handled. Exists for idempotency:
/// providers retry, and Composio retries anything not acknowledged fast, so
/// without a dedupe key on the provider's own event id a slow handler sends
/// the same email twice.
///
/// Deliberately stores no payload. Trigger payloads carry email bodies and
/// calendar contents — the same reason McpActionLog stores no arguments.
model McpTriggerEvent {
  /// Event id.
  id              String                @id @default(uuid())
  /// The provider's own event identifier — the dedupe key.
  providerEventId String                @unique
  /// Owning organization id.
  organizationId  String
  /// Subscription this arrived for.
  subscriptionId  String
  /// Trigger type slug, denormalized for cheap display.
  triggerSlug     String
  /// Processing state.
  status          McpTriggerEventStatus @default(RECEIVED)
  /// Why it was skipped or how it failed.
  error           String?
  /// Creation timestamp.
  createdAt       DateTime              @default(now())
  /// When handling finished.
  processedAt     DateTime?

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("mcp_trigger_event")
}

/// Per-org rule for whether a proposed write needs a human.
///
/// Veqiro's whole safety story is that an agent proposes and a person decides.
/// That is right for sending an email and absurd for adding a calendar hold the
/// owner asked for ten times this week, so the rule is configurable — but only
/// downward from ALWAYS_ASK, deliberately, and only by explicit choice.
///
/// `"*"` is the wildcard rather than NULL: Postgres treats NULLs as distinct in
/// unique indexes, so a nullable column would happily accept ten conflicting
/// "applies to everything" rules.
model McpApprovalPolicy {
  /// Policy id.
  id              String          @id @default(uuid())
  /// Owning organization id.
  organizationId  String
  /// Catalog slug this applies to, or "*" for every integration.
  integrationSlug String          @default("*")
  /// Provider tool slug this applies to, or "*" for every tool.
  toolName        String          @default("*")
  /// What to do when a write matching this rule is proposed.
  mode            McpApprovalMode
  /// User who set the rule — an audit question people actually ask.
  createdByUserId String
  /// Creation timestamp.
  createdAt       DateTime        @default(now())
  /// Update timestamp.
  updatedAt       DateTime        @updatedAt

  @@unique([organizationId, integrationSlug, toolName])
  @@index([organizationId])
  @@map("mcp_approval_policy")
}

/// A named, repeatable job an org has switched on — "Monday briefing",
/// "Inbox triage". The unit customers actually think in: they do not want
/// "an agent with Gmail access", they want their Monday morning handled.
///
/// The definition lives in code (mcp.plays.ts), not here: the prompt and the
/// tools a play needs are product decisions that get revised, and revising them
/// should not require migrating every org's row. This table holds only what is
/// per-org — whether it runs, when, and under whose identity.
model McpPlay {
  /// Play subscription id.
  id              String    @id @default(uuid())
  /// Owning organization id.
  organizationId  String
  /// Catalog id from mcp.plays.ts, e.g. "monday-briefing".
  playId          String
  /// Cron expression this runs on, copied from the catalog at enable time so a
  /// later catalog change doesn't silently move a customer's Monday.
  schedule        String
  /// Whether it currently runs.
  enabled         Boolean   @default(true)
  /// User whose identity the run — and anything it proposes — belongs to.
  createdByUserId String
  /// Last time a run started.
  lastRunAt       DateTime?
  /// Last failure, if the most recent run failed.
  lastError       String?
  /// Creation timestamp.
  createdAt       DateTime  @default(now())
  /// Update timestamp.
  updatedAt       DateTime  @updatedAt

  @@unique([organizationId, playId])
  @@index([enabled])
  @@map("mcp_play")
}

/// A toolkit's tool catalog, cached across restarts and instances.
///
/// composioAdapter.listTools resolves on the toolkit slug alone — granted
/// scopes decide whether a *call* succeeds, not which tools exist — so one row
/// serves every org, agent and user. Slack's is 167 tools and 233 KB.
///
/// This is the second tier behind an in-process cache, not a replacement for
/// it: reading 233 KB of JSON on every chat turn would be worse than the API
/// call it replaces. It exists so a restart or a new instance doesn't refetch
/// every catalog from Composio, which was the one real gap in caching this
/// purely in memory.
model McpToolCatalog {
  /// Provider's toolkit slug, e.g. "slack" — the natural key, since the
  /// catalog is a property of the toolkit and nothing else.
  toolkitSlug String      @id
  /// Which provider this came from.
  provider    McpProvider @default(COMPOSIO)
  /// The tool definitions as returned by the adapter.
  tools       Json
  /// Denormalized for cheap "is this suspiciously empty" checks without
  /// deserializing the payload.
  toolCount   Int
  /// When this was last read from the provider.
  fetchedAt   DateTime    @default(now())

  @@map("mcp_tool_catalog")
}

/// A toolkit's available trigger types, cached like its tool catalog and for
/// the same reason: listTypes resolves on the toolkit slug alone, so one row
/// serves every org. Verified across the catalog — 21 of 46 toolkits expose
/// triggers at all, 191 types between them.
model McpTriggerCatalog {
  /// Provider's toolkit slug, e.g. "slack".
  toolkitSlug  String      @id
  /// Which provider this came from.
  provider     McpProvider @default(COMPOSIO)
  /// Trigger types as returned by the provider.
  triggers     Json
  /// Denormalized count, so "does this toolkit trigger at all" is answerable
  /// without deserializing.
  triggerCount Int
  /// When this was last read from the provider.
  fetchedAt    DateTime    @default(now())

  @@map("mcp_trigger_catalog")
}

/// A week's content plan — the artifact Maya's planning play produces.
///
/// Stored rather than left in chat because a plan is something you come back
/// to, tick through, and act on across a week; a markdown blob in a message
/// list is unreadable by Wednesday.
///
/// `rawText` is always kept and `items` may be null: the plan is generated by
/// a model asked for JSON, and when that parse fails the answer is to show the
/// prose it did produce, not an error. A plan that renders plainly beats a
/// plan that vanished.
model MayaContentPlan {
  /// Plan id.
  id             String   @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// User the run belongs to.
  userId         String
  /// Monday of the week this covers.
  weekStart      DateTime
  /// What signal the plan was built on — including admissions that the data
  /// was thin, which is the most useful sentence in the whole artifact.
  note           String?
  /// Parsed items. Null when the model's JSON could not be read.
  items          Json?
  /// The model's full response, always retained.
  rawText        String
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("maya_content_plan")
}

/// Maya social post publication record.
model PublishedPost {
  /// Published post id.
  id                String         @id @default(uuid())
  /// Owning organization id.
  organizationId    String
  /// User who initiated publish.
  userId            String
  /// Connected account used for publishing.
  socialAccountId   String?
  /// Connected account relation.
  socialAccount     SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  /// Target platform.
  platform          SocialPlatform
  /// Provider-side post id.
  platformPostId    String?
  /// Published caption/body.
  caption           String
  /// Hashtags included in the post.
  hashtags          String[]
  /// Optional image URL used in the post.
  imageUrl          String?
  /// Optional video URL used in the post.
  videoUrl          String?
  /// Additional carousel image URLs (Instagram carousels only); imageUrl holds the first.
  imageUrls         String[]       @default([])
  /// Instagram post-vs-reel selection, preserved for scheduled video posts.
  postType          String?
  /// Publish status: pending, scheduled, publishing, success, failed, or cancelled.
  status            String         @default("pending")
  /// Publish error message when failed.
  error             String?
  /// Provider publish timestamp.
  publishedAt       DateTime?
  /// When set (status = "scheduled"), the time the post should be auto-published.
  scheduledAt       DateTime?
  /// Set once a scheduled post's failure has been emailed/toasted, to avoid duplicate notifications.
  failureNotifiedAt DateTime?
  /// Local creation timestamp.
  createdAt         DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, status, publishedAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, platform, createdAt])
  @@index([socialAccountId])
  @@index([status, scheduledAt])
  @@map("published_post")
}

/// Maya-generated idea saved to avoid repeats.
model MayaContentIdea {
  /// Idea id.
  id             String         @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// Platform this idea targets.
  platform       SocialPlatform
  /// Idea title.
  title          String
  /// Opening hook.
  hook           String
  /// Content format/type.
  contentType    String
  /// Creation timestamp.
  createdAt      DateTime       @default(now())
  /// Whether this idea has been used/published.
  isPublished    Boolean        @default(false)

  @@index([organizationId, platform, createdAt])
  @@index([organizationId, isPublished, createdAt])
  @@index([createdAt])
  @@map("maya_content_idea")
}

/// Sage saved SEO keyword bookmark.
model SageSavedKeyword {
  /// Saved keyword id.
  id                   String   @id @default(uuid())
  /// Owning organization id.
  organizationId       String
  /// Keyword phrase.
  keyword              String
  /// Search intent label.
  searchIntent         String   @default("")
  /// Estimated difficulty from 0 to 100.
  estimatedDifficulty  Int      @default(50)
  /// Relevance score from 0 to 1.
  relevanceScore       Float    @default(0.5)
  /// Human-readable search volume estimate.
  searchVolumeEstimate String?
  /// Suggested content format for the keyword.
  suggestedContentType String   @default("")
  /// Creation timestamp.
  createdAt            DateTime @default(now())

  @@unique([organizationId, keyword])
  @@index([organizationId, createdAt])
  @@index([estimatedDifficulty])
  @@map("sage_saved_keyword")
}

/// Lex uploaded source metadata; RAG chunks live in the AI service.
model LexSource {
  /// Source row id.
  id             String   @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// User who uploaded the source.
  userId         String
  /// Owning agent; currently always LEX.
  agent          Agent
  /// AI-service source id used for RAG queries.
  sourceId       String
  /// User-facing document name.
  name           String
  /// User-selected document type.
  type           String   @default("")
  /// AI-detected document type.
  typeDetected   String?
  /// R2 object key; public URL is derived from this key.
  r2Key          String
  /// Uploaded file size in bytes.
  sizeBytes      Int      @default(0)
  /// Parsed page count.
  pageCount      Int      @default(0)
  /// Number of RAG chunks created by the AI service.
  chunksCreated  Int      @default(0)
  /// AI-generated source summary.
  summary        String   @default("")
  /// AI-extracted key topics.
  keyTopics      String[] @default([])
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@unique([userId, sourceId])
  @@index([userId, organizationId, agent, createdAt])
  @@index([organizationId, agent, createdAt])
  @@map("lex_source")
}

/// Rex metric dataset parsed from uploads or ingest API.
model RexDataset {
  /// Dataset id.
  id             String   @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// User or integration owner id.
  userId         String
  /// Optional external/source id.
  sourceId       String?
  /// Dataset display name.
  name           String
  /// Canonical metric key, such as mrr.
  metricKey      String
  /// Metric unit, such as USD or users.
  unit           String?
  /// Period granularity label.
  period         String
  /// Dataset purpose, usually actual or forecast.
  purpose        String   @default("actual")
  /// Time-series points JSON.
  points         Json
  /// Parsed raw table and import metadata.
  meta           Json?
  /// Creation timestamp.
  createdAt      DateTime @default(now())
  /// Update timestamp.
  updatedAt      DateTime @updatedAt

  @@index([organizationId, updatedAt])
  @@index([organizationId, metricKey, purpose, updatedAt])
  @@map("rex_dataset")
}

/// Rex result card pinned to the Today/dashboard surface.
model RexPinnedCard {
  /// Pin id.
  id             String   @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// User who pinned the card.
  userId         String
  /// Card kind/type.
  kind           String
  /// Full card payload JSON.
  payload        Json
  /// Sort position in the pinned list.
  position       Int      @default(0)
  /// Whether the card is publicly shareable.
  isPublic       Boolean  @default(false)
  /// Public share token when sharing is enabled.
  shareToken     String?  @unique
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@index([organizationId, position])
  @@map("rex_pinned_card")
}

/// Rex organization-level settings.
model RexSettings {
  /// Owning organization id and primary key.
  organizationId         String   @id
  /// Whether weekly digest cron should include this org.
  weeklyDigestEnabled    Boolean  @default(true)
  /// Preferred digest timezone.
  weeklyDigestTimezone   String   @default("UTC")
  /// Email recipients for digest delivery.
  weeklyDigestRecipients String[]
  /// JSON alert rule configuration.
  alertRules             Json?
  /// Optional API key for metrics ingestion.
  ingestApiKey           String?  @unique
  /// Saved column mapping templates for uploads.
  columnMappingTemplates Json?
  /// Update timestamp.
  updatedAt              DateTime @updatedAt

  @@index([weeklyDigestEnabled])
  @@map("rex_settings")
}

/// Vega email follow-up reminder.
model VegaFollowUp {
  /// Follow-up id.
  id             String         @id @default(cuid())
  /// Gmail message id being followed up.
  emailId        String
  /// Email subject snapshot.
  emailSubject   String
  /// Sender email snapshot.
  senderEmail    String
  /// Due timestamp for the reminder.
  dueAt          DateTime
  /// Draft text to use when following up.
  draftText      String         @db.Text
  /// Follow-up lifecycle status.
  status         FollowUpStatus @default(PENDING)
  /// Owning organization id.
  organizationId String
  /// Creation timestamp.
  createdAt      DateTime       @default(now())
  /// Update timestamp.
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([status, dueAt])
  @@map("vega_follow_up")
}

/// Vega VIP contact used to prioritize inbox items.
model VIPContact {
  /// VIP contact id.
  id             String   @id @default(cuid())
  /// VIP email address.
  email          String
  /// Optional display name.
  name           String?
  /// Owning organization id.
  organizationId String
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@unique([email, organizationId])
  @@index([organizationId, createdAt])
  @@map("vip_contact")
}

/// Cached Vega briefing content for one day/type.
model VegaBriefingCache {
  /// Briefing id.
  id             String       @id @default(cuid())
  /// Calendar date in YYYY-MM-DD format.
  date           String
  /// Briefing cadence/type.
  type           BriefingType
  /// Full briefing payload JSON.
  content        Json
  /// Owning organization id.
  organizationId String
  /// Last generation timestamp.
  generatedAt    DateTime     @default(now())

  @@unique([date, type, organizationId])
  @@index([organizationId, date])
  @@map("vega_briefing_cache")
}

/// Vega custom inbox label.
model VegaLabel {
  /// Label id.
  id             String   @id @default(cuid())
  /// Label display name.
  name           String
  /// Hex color used in the UI.
  color          String   @default("#999999")
  /// Classification guidance used by Vega when choosing this label.
  rationale      String   @default("")
  /// Whether Vega should auto-draft replies for this label.
  autoReply      Boolean  @default(false)
  /// Owning organization id.
  organizationId String
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@unique([name, organizationId])
  @@index([organizationId, createdAt])
  @@map("vega_label")
}

/// Latest processed Vega inbox snapshot for one organization.
model VegaInboxSnapshot {
  /// Snapshot id.
  id             String   @id @default(cuid())
  /// Owning organization id.
  organizationId String   @unique
  /// Processed inbox response cached for fast UI loads.
  snapshot       Json
  /// Cache timestamp used for TTL checks.
  cachedAt       DateTime @default(now())

  @@map("vega_inbox_snapshot")
}

// ─── Feedback / Voting System ────────────────────────────────────────────────

/// Status lifecycle of a user-submitted feedback post.
enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  LAUNCHED
  DECLINED
}

/// Categorisation tag on a feedback post.
enum FeedbackCategory {
  FEATURE_REQUEST
  BUG_REPORT
  INTEGRATION
  NEW_AGENT
  UX_IMPROVEMENT
  GENERAL
}

/// A feature request / bug report submitted by a user.
model FeedbackPost {
  /// Row id.
  id           String            @id @default(cuid())
  /// Short title supplied by the submitter.
  title        String
  /// Longer description supplied by the submitter.
  description  String
  /// Categorisation tag.
  category     FeedbackCategory  @default(GENERAL)
  /// Optional agent this feedback relates to.
  agentSlug    String?
  /// Current lifecycle status.
  status       FeedbackStatus    @default(NEW)
  /// Cached vote tally (incremented/decremented atomically).
  voteCount    Int               @default(0)
  /// Optional public-facing ETA shown on the roadmap.
  roadmapEta   String?
  /// Optional public admin reply shown to voters.
  adminReply   String?
  /// Optional internal-only admin note.
  adminNote    String?
  /// Whether the post has been merged into another.
  isMerged     Boolean           @default(false)
  /// Target post id when this post was merged.
  mergedIntoId String?
  /// Submitting user id.
  createdById  String
  /// Submitting user relation.
  createdBy    User              @relation("FeedbackPostAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  /// Creation timestamp.
  createdAt    DateTime          @default(now())
  /// Last-updated timestamp.
  updatedAt    DateTime          @updatedAt
  /// Votes cast on this post.
  votes        FeedbackVote[]
  /// Comments on this post.
  comments     FeedbackComment[]

  @@index([status])
  @@index([category])
  @@index([agentSlug])
  @@index([createdById])
  @@index([voteCount])
  @@index([createdAt])
  @@map("feedback_post")
}

/// A single upvote by a user on a FeedbackPost.
model FeedbackVote {
  /// Row id.
  id         String       @id @default(cuid())
  /// Voting user id.
  userId     String
  /// Voting user relation.
  user       User         @relation("FeedbackVoteUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Target post id.
  feedbackId String
  /// Target post relation.
  feedback   FeedbackPost @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// Vote timestamp.
  createdAt  DateTime     @default(now())

  @@unique([userId, feedbackId])
  @@index([userId])
  @@index([feedbackId])
  @@map("feedback_vote")
}

/// A comment left by a user (or admin) on a FeedbackPost.
model FeedbackComment {
  /// Row id.
  id           String       @id @default(cuid())
  /// Comment text.
  content      String
  /// Commenting user id.
  userId       String
  /// Commenting user relation.
  user         User         @relation("FeedbackCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Parent post id.
  feedbackId   String
  /// Parent post relation.
  feedback     FeedbackPost @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// True when the comment was written by a platform admin.
  isAdminReply Boolean      @default(false)
  /// Creation timestamp.
  createdAt    DateTime     @default(now())

  @@index([feedbackId])
  @@index([userId])
  @@map("feedback_comment")
}

/// A potential upcoming agent shown on the voting page.
model UpcomingAgent {
  /// Row id.
  id          String              @id @default(cuid())
  /// Display name of the proposed agent.
  name        String
  /// One-line tagline shown in the card.
  tagline     String
  /// Optional longer description.
  description String?
  /// Optional emoji avatar.
  emoji       String?
  /// Optional brand colour (hex or Tailwind name).
  color       String?
  /// Sort order for display.
  order       Int                 @default(0)
  /// Whether the card is visible to users.
  isVisible   Boolean             @default(true)
  /// Cached vote tally.
  voteCount   Int                 @default(0)
  /// Creation timestamp.
  createdAt   DateTime            @default(now())
  /// Last-updated timestamp.
  updatedAt   DateTime            @updatedAt
  /// Votes cast on this agent.
  votes       UpcomingAgentVote[]

  @@index([isVisible, order])
  @@map("upcoming_agent")
}

/// A single upvote by a user on an UpcomingAgent.
model UpcomingAgentVote {
  /// Row id.
  id              String        @id @default(cuid())
  /// Voting user id.
  userId          String
  /// Voting user relation.
  user            User          @relation("UpcomingAgentVoteUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Target agent id.
  upcomingAgentId String
  /// Target agent relation.
  upcomingAgent   UpcomingAgent @relation(fields: [upcomingAgentId], references: [id], onDelete: Cascade)
  /// Vote timestamp.
  createdAt       DateTime      @default(now())

  @@unique([userId, upcomingAgentId])
  @@index([userId])
  @@index([upcomingAgentId])
  @@map("upcoming_agent_vote")
}

/// Pre-launch waitlist entry collected before product launch.
model WaitlistEntry {
  id        String    @id @default(cuid())
  email     String    @unique
  coupon    String?
  validTill DateTime?
  createdAt DateTime  @default(now())

  @@map("waitlist_entry")
}

/// Scheduled task owned by an organization — agent-automated or user-defined.
/// UNUSED — the Task feature was removed. Recurring work is now McpPlay and
/// event-driven work is McpTriggerSubscription; see the Tasks page.
///
/// The table is kept rather than dropped so the 48 rows that existed across 16
/// organizations aren't destroyed by a decision that could be revisited. The
/// cron that fired them is gone, so nothing here runs any more.
model Task {
  /// Task id.
  id             String       @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// Owning organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Display name.
  name           String
  /// Optional description.
  description    String?
  /// Whether this is an automated agent task or a user-defined general task.
  type           TaskType     @default(GENERAL)
  /// Agent responsible for running this task (AGENT type only).
  agent          Agent?
  /// CRON expression for recurrence (null means one-off).
  cronExpression String?
  /// IANA timezone for the cron schedule.
  timezone       String       @default("UTC")
  /// Whether the task is active and should run on schedule.
  isEnabled      Boolean      @default(true)
  /// True when seeded as a default task at org creation.
  isDefault      Boolean      @default(false)
  /// Extra configuration passed to the agent handler.
  payload        Json?
  /// Timestamp of the last run.
  lastRunAt      DateTime?
  /// Next scheduled run timestamp (computed from cron expression).
  nextRunAt      DateTime?
  /// Creation timestamp.
  createdAt      DateTime     @default(now())
  /// Update timestamp.
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([nextRunAt, isEnabled])
  @@map("task")
}

// ─── Expense Tracker ─────────────────────────────────────────────────────────

/// Expense category tag.
enum ExpenseCategory {
  FOOD
  TRAVEL
  ACCOMMODATION
  OFFICE
  ENTERTAINMENT
  UTILITIES
  SUBSCRIPTIONS
  EQUIPMENT
  OTHER
}

/// How the cost is divided among members.
enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

/// A named group of people sharing expenses (e.g. "Team Offsite", "Office").
model ExpenseGroup {
  /// Group id.
  id          String               @id @default(cuid())
  /// Display name.
  name        String
  /// Optional description.
  description String?
  /// User who created the group.
  createdById String
  /// Default currency for new expenses.
  currency    String               @default("USD")
  /// Creation timestamp.
  createdAt   DateTime             @default(now())
  /// Update timestamp.
  updatedAt   DateTime             @updatedAt
  /// Group members.
  members     ExpenseGroupMember[]
  /// Expenses in this group.
  expenses    Expense[]
  /// Settlements recorded in this group.
  settlements Settlement[]

  @@index([createdAt])
  @@map("expense_group")
}

/// Free-text named member of an ExpenseGroup (not linked to an app user account).
model ExpenseGroupMember {
  /// Row id.
  id              String         @id @default(cuid())
  /// Group this membership belongs to.
  groupId         String
  /// Display name for this member (free text).
  name            String
  /// When the member was added.
  joinedAt        DateTime       @default(now())
  /// Group relation.
  group           ExpenseGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Expenses paid by this member.
  expenses        Expense[]      @relation("ExpensePaidByMember")
  /// Splits this member is responsible for.
  expenseSplits   ExpenseSplit[]
  /// Settlements where this member is the payer.
  settlementsFrom Settlement[]   @relation("SettlementFromMember")
  /// Settlements where this member is the receiver.
  settlementsTo   Settlement[]   @relation("SettlementToMember")

  @@unique([groupId, name])
  @@index([groupId])
  @@map("expense_group_member")
}

/// A single expense logged in an ExpenseGroup.
model Expense {
  /// Expense id.
  id             String             @id @default(cuid())
  /// Owning group id.
  groupId        String
  /// Short description of the expense.
  title          String
  /// Amount in the original currency.
  amount         Float
  /// ISO-4217 currency code.
  currency       String             @default("USD")
  /// Amount converted to USD for balance calculations.
  amountUsd      Float
  /// Category tag.
  category       ExpenseCategory    @default(OTHER)
  /// Member who paid for this expense.
  paidByMemberId String
  /// Optional receipt image/PDF URL (R2).
  receiptUrl     String?
  /// Optional free-text notes.
  notes          String?
  /// Date the expense occurred.
  date           DateTime
  /// Whether this expense recurs on a schedule.
  isRecurring    Boolean            @default(false)
  /// CRON expression for recurrence (null if not recurring).
  cronExpression String?
  /// Next scheduled recurrence timestamp.
  nextRunAt      DateTime?
  /// Creation timestamp.
  createdAt      DateTime           @default(now())
  /// Update timestamp.
  updatedAt      DateTime           @updatedAt
  /// Owning group relation.
  group          ExpenseGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Member who paid.
  paidByMember   ExpenseGroupMember @relation("ExpensePaidByMember", fields: [paidByMemberId], references: [id])
  /// How the cost is split among members.
  splits         ExpenseSplit[]

  @@index([groupId, date])
  @@index([groupId, category])
  @@index([paidByMemberId])
  @@index([isRecurring, nextRunAt])
  @@map("expense")
}

/// One member's share of a single Expense.
model ExpenseSplit {
  /// Row id.
  id             String             @id @default(cuid())
  /// Parent expense id.
  expenseId      String
  /// Group member responsible for this share.
  memberId       String
  /// How the split was computed.
  splitType      SplitType
  /// Share amount in the expense's original currency.
  shareAmount    Float
  /// Share amount converted to USD.
  shareAmountUsd Float
  /// Parent expense relation.
  expense        Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// Member relation.
  member         ExpenseGroupMember @relation(fields: [memberId], references: [id])

  @@unique([expenseId, memberId])
  @@index([expenseId])
  @@index([memberId])
  @@map("expense_split")
}

/// Per-billing-period credit usage for the Maya agent.
model MayaUsage {
  /// Record id.
  id             String       @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// Inclusive start of the billing period (UTC).
  periodStart    DateTime
  /// Exclusive end of the billing period (UTC).
  periodEnd      DateTime
  /// Total credits consumed this period (1 image = 2 credits, 1 video-second = 4 credits).
  creditsUsed    Int          @default(0)
  /// Extra credits purchased via a Maya credit top-up this period, added on top
  /// of the plan's tier limit. Kept separate from creditsUsed so "used" never
  /// goes negative on the frontend — effective limit = tier limit + bonusCredits.
  bonusCredits   Int          @default(0)
  /// Record creation timestamp.
  createdAt      DateTime     @default(now())
  /// Record update timestamp.
  updatedAt      DateTime     @updatedAt
  /// Owning organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart])
  @@index([organizationId])
  @@map("maya_usage")
}

/// A recorded debt payment between two group members.
model Settlement {
  /// Settlement id.
  id           String             @id @default(cuid())
  /// Group this settlement belongs to.
  groupId      String
  /// Member who is paying.
  fromMemberId String
  /// Member who is receiving payment.
  toMemberId   String
  /// Amount paid in the settlement currency.
  amount       Float
  /// ISO-4217 currency code.
  currency     String             @default("USD")
  /// Amount converted to USD.
  amountUsd    Float
  /// Payment method (e.g. "UPI", "Cash", "Bank Transfer").
  method       String?
  /// Optional notes.
  notes        String?
  /// When the settlement was recorded.
  settledAt    DateTime           @default(now())
  /// Group relation.
  group        ExpenseGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Payer relation.
  fromMember   ExpenseGroupMember @relation("SettlementFromMember", fields: [fromMemberId], references: [id])
  /// Receiver relation.
  toMember     ExpenseGroupMember @relation("SettlementToMember", fields: [toMemberId], references: [id])

  @@index([groupId, settledAt])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@map("settlement")
}

// ─────────────────────────────────────────────────────────────────────────
// Planned multi-step runs
//
// A run is one user request decomposed by the planner into a DAG of steps,
// approved as a whole, then executed in the background by apps/ai. Node owns
// this state and all authorisation; apps/ai reports transitions over the
// internal REST channel and never writes these rows itself.
//
// Two tables rather than one row with the DAG as JSON: steps transition
// independently and often concurrently, so a JSON blob would make every
// transition a read-modify-write and two branches finishing in the same tick
// a lost update. Separate rows also let McpPendingAction carry a real FK.
// ─────────────────────────────────────────────────────────────────────────

/// Lifecycle of a planned run.
enum AgentRunStatus {
  /// Planner is decomposing the request.
  PLANNING
  /// Plan is built and waiting for the user to approve it.
  AWAITING_PLAN_APPROVAL
  /// Executing approved steps.
  RUNNING
  /// A replan introduced a write the user never approved.
  AWAITING_ACTION_APPROVAL
  /// Repairing the plan around a failed step.
  REPLANNING
  /// Every enabled step succeeded.
  COMPLETED
  /// Finished, but something failed, was blocked, or was skipped.
  PARTIAL
  /// Nothing useful completed.
  FAILED
  /// Cancelled by the user.
  CANCELLED
  /// Plan discarded before it ran.
  REJECTED
}

/// Lifecycle of one node in a run's DAG.
enum AgentRunStepStatus {
  /// In the plan, not yet approved or scheduled.
  PLANNED
  /// Switched off by the user pre-approval, or cascaded from one that was.
  DISABLED
  /// A dependency failed, was disabled, or is awaiting approval.
  BLOCKED
  /// Dependencies satisfied, waiting for a scheduling slot.
  READY
  /// Currently executing.
  RUNNING
  /// Paused on a write the user has not authorised.
  AWAITING_APPROVAL
  /// Finished successfully.
  SUCCEEDED
  /// Failed after its retry.
  FAILED
  /// Never ran — run budget exhausted, or cancelled first.
  SKIPPED
}

/// What started a run.
enum AgentRunTrigger {
  CHAT
  TRIGGER
  PLAY
}

/// One planned, approved and executed multi-step request.
model AgentRun {
  /// Run id.
  id               String          @id @default(uuid())
  /// Owning organization id.
  organizationId   String
  /// User who made the request.
  userId           String
  /// Agent the user was talking to. For a team run this is the lead — the
  /// agent owning the first step — since the run itself spans several.
  agent            Agent
  /// True when planned from the shared team thread, where the planner sees
  /// every agent and the union of their connected integrations.
  isTeam           Boolean         @default(false)
  /// Whether this came from chat, an inbound trigger, or a scheduled play.
  trigger          AgentRunTrigger @default(CHAT)
  /// Verbatim request that started the run.
  requestText      String
  /// Current lifecycle state.
  status           AgentRunStatus  @default(PLANNING)
  /// Planner's one-sentence restatement of the goal.
  goal             String          @default("")
  /// Bumped by every replan so a poll can detect the graph changed.
  planVersion      Int             @default(1)
  /// Model, gate score, token spend, replan count, unavailable integrations.
  plannerMeta      Json?
  /// Write identities the user authorised, as "agent|integrationSlug".
  /// Deliberately excludes arguments: they are computed from data the user
  /// has not seen at approval time, so including them would re-ask for every
  /// write and defeat approve-once.
  approvedWrites   String[]        @default([])
  /// User who approved the plan.
  approvedByUserId String?
  /// When the plan was approved.
  approvedAt       DateTime?
  /// Assistant message that renders the graph and final summary.
  messageId        String?
  /// The message rendering this run.
  message          Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  /// Final synthesis written when the run finishes.
  summary          String?
  /// Failure detail, when the run did not complete.
  errorMessage     String?
  /// Liveness signal from the executor; drives orphan recovery.
  heartbeatAt      DateTime?
  /// Times the sweeper re-dispatched this run. Capped so a poison run stops.
  resumeCount      Int             @default(0)
  /// Tool calls consumed across every step, against the run-wide budget.
  toolCallsUsed    Int             @default(0)
  /// When execution began.
  startedAt        DateTime?
  /// When the run reached a terminal state.
  finishedAt       DateTime?
  /// Creation timestamp.
  createdAt        DateTime        @default(now())
  /// Update timestamp.
  updatedAt        DateTime        @updatedAt
  /// The DAG.
  steps            AgentRunStep[]

  @@index([organizationId, status])
  @@index([organizationId, agent, createdAt])
  @@index([status, heartbeatAt])
  @@map("agent_run")
}

/// One node in a run's DAG.
model AgentRunStep {
  /// Step id.
  id              String             @id @default(uuid())
  /// Owning run id.
  runId           String
  /// The run this belongs to.
  run             AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Planner-assigned stable key ("s1"); also the graph node id.
  key             String
  /// Layout ordering hint only — never execution order, which comes from dependsOn.
  seq             Int
  /// Specialist that executes this step.
  agent           Agent
  /// Short label shown on the graph node.
  title           String
  /// Instruction handed to that agent as its user message.
  intent          String
  /// Catalog slug this step should use, when it targets one integration.
  integrationSlug String?
  /// Whether this step changes anything outside Veqiro.
  isWrite         Boolean            @default(false)
  /// Planner-declared blast radius, shown on the approval card.
  expectedScope   String?
  /// Keys of steps that must succeed first.
  dependsOn       String[]           @default([])
  /// Current lifecycle state.
  status          AgentRunStepStatus @default(PLANNED)
  /// False once the user toggles it off, or a dependency is toggled off.
  enabled         Boolean            @default(true)
  /// Retry counter; a step gets exactly one retry.
  attempt         Int                @default(0)
  /// Same shape as apps/ai's _build_tool_trace output.
  toolTrace       Json?
  /// Text passed to dependent steps as context.
  outputText      String?
  /// Frontend AgentActionId, when this step produced a card.
  actionId        String?
  /// Card payload.
  actionResult    Json?
  /// Frontend AgentActionId this step paused on for the user to review, when
  /// it reached a tool whose inputs they confirm in that action's own form.
  proposedActionId String?
  /// Arguments the model proposed for that action, used to prefill the form.
  proposedArgs    Json?
  /// Failure detail.
  errorMessage    String?
  /// When the step began.
  startedAt       DateTime?
  /// When the step settled.
  finishedAt      DateTime?
  /// Creation timestamp.
  createdAt       DateTime           @default(now())
  /// Update timestamp.
  updatedAt       DateTime           @updatedAt
  /// Writes this step proposed.
  pendingActions  McpPendingAction[]

  @@unique([runId, key])
  @@index([runId, status])
  @@map("agent_run_step")
}
