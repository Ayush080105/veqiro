generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Product agents available in the workspace.
enum Agent {
  MAYA
  SAGE
  LEX
  REX
  SCOUT
  VEGA
}

/// Social publishing destinations supported by Maya.
enum SocialPlatform {
  TWITTER
  LINKEDIN
  INSTAGRAM
}

/// Local entitlement state mirrored from the billing provider.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Paid subscription cadence.
enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

/// Billing entitlement shape.
enum SubscriptionEntitlementMode {
  CREW
  CUSTOM
}

/// Task type: agent-automated vs user-defined general task.
enum TaskType {
  AGENT
  GENERAL
}

/// Vega follow-up lifecycle.
enum FollowUpStatus {
  PENDING
  SENT
  CANCELLED
  OVERDUE
}

/// Cached Vega briefing cadence.
enum BriefingType {
  MORNING
  EVENING
  WEEKLY
}

/// Better Auth user plus admin flags.
model User {
  /// Better Auth user id.
  id            String       @id
  /// Display name shown in the app.
  name          String
  /// Login email and unique user identifier.
  email         String
  /// Whether the email address has been verified.
  emailVerified Boolean      @default(false)
  /// Optional profile image URL from the auth provider.
  image         String?
  /// User creation timestamp.
  createdAt     DateTime     @default(now())
  /// User update timestamp maintained by Prisma.
  updatedAt     DateTime     @updatedAt
  /// Optional app/admin role.
  role          String?
  /// Better Auth ban flag.
  banned        Boolean?     @default(false)
  /// Optional ban reason visible to admins.
  banReason     String?
  /// Optional ban expiry timestamp.
  banExpires    DateTime?
  /// Auth sessions owned by this user.
  sessions      Session[]
  /// OAuth/password accounts linked to this user.
  accounts      Account[]
  /// Organization memberships for this user.
  members              Member[]
  /// Organization invitations sent by this user.
  invitations          Invitation[]
  /// Feedback posts authored by this user.
  feedbackPosts        FeedbackPost[]       @relation("FeedbackPostAuthor")
  /// Upvotes cast by this user on feedback posts.
  feedbackVotes        FeedbackVote[]       @relation("FeedbackVoteUser")
  /// Comments left by this user on feedback posts.
  feedbackComments     FeedbackComment[]    @relation("FeedbackCommentUser")
  /// Upvotes cast by this user on upcoming agents.
  upcomingAgentVotes   UpcomingAgentVote[]  @relation("UpcomingAgentVoteUser")
  @@unique([email])
  @@map("user")
}

/// Better Auth session.
model Session {
  /// Better Auth session id.
  id                   String   @id
  /// Session expiry timestamp.
  expiresAt            DateTime
  /// Unique bearer session token.
  token                String
  /// Session creation timestamp.
  createdAt            DateTime @default(now())
  /// Session update timestamp.
  updatedAt            DateTime @updatedAt
  /// Last known client IP.
  ipAddress            String?
  /// Last known user agent string.
  userAgent            String?
  /// Owning user id.
  userId               String
  /// Owning user relation.
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Admin impersonator id when impersonation is active.
  impersonatedBy       String?
  /// Organization currently selected in the UI.
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// Better Auth account/provider credentials.
model Account {
  /// Better Auth account row id.
  id                    String    @id
  /// Provider account id, such as Google subject id.
  accountId             String
  /// Provider name, such as google.
  providerId            String
  /// Owning user id.
  userId                String
  /// Owning user relation.
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OAuth access token used for provider APIs.
  accessToken           String?
  /// OAuth refresh token used to refresh access.
  refreshToken          String?
  /// OAuth/OIDC id token.
  idToken               String?
  /// Access token expiry timestamp.
  accessTokenExpiresAt  DateTime?
  /// Refresh token expiry timestamp.
  refreshTokenExpiresAt DateTime?
  /// OAuth scope string granted by the provider.
  scope                 String?
  /// Password hash for credential auth, when used.
  password              String?
  /// Account creation timestamp.
  createdAt             DateTime  @default(now())
  /// Account update timestamp.
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([userId, providerId, updatedAt])
  @@index([providerId, userId])
  @@map("account")
}

/// Better Auth verification token.
model Verification {
  /// Verification row id.
  id         String   @id
  /// Verification target, usually email or token namespace.
  identifier String
  /// Verification secret/value.
  value      String
  /// Expiry timestamp.
  expiresAt  DateTime
  /// Creation timestamp.
  createdAt  DateTime @default(now())
  /// Update timestamp.
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Tenant organization and denormalized entitlement state.
model Organization {
  /// Better Auth organization id.
  id                   String              @id
  /// Organization display name.
  name                 String
  /// Unique URL/workspace slug.
  slug                 String
  /// Optional organization logo URL.
  logo                 String?
  /// Organization creation timestamp.
  createdAt            DateTime
  /// Better Auth metadata blob stored as string.
  metadata             String?
  /// Whether onboarding/brand kit setup is complete.
  onboarded            Boolean             @default(false)
  /// Users belonging to this organization.
  members              Member[]
  /// Pending invitations for this organization.
  invitations          Invitation[]
  /// Fast entitlement status used by middleware.
  subscriptionStatus   SubscriptionStatus?
  /// Fast entitlement expiry used by middleware.
  entitlementExpiresAt DateTime?
  /// Fast per-agent unlocks used by middleware.
  unlockedAgents       Agent[]              @default([])
  /// Source billing subscription row.
  subscription         Subscription?
  /// Per-agent memory summaries.
  agentMemory          AgentMemory[]
  /// Organization-wide memory summary.
  orgMemory            OrgMemory?
  /// Scheduled tasks owned by this organization.
  tasks                Task[]

  @@unique([slug])
  @@index([subscriptionStatus])
  @@index([createdAt])
  @@index([subscriptionStatus, entitlementExpiresAt])
  @@map("organization")
}

/// Billing provider subscription record for one organization.
model Subscription {
  /// Local subscription id.
  id                 String       @id @default(cuid())
  /// Owning organization id.
  organizationId     String       @unique
  /// Owning organization relation.
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Dodo customer id.
  dodoCustomerId     String       @unique
  /// Dodo subscription id after checkout activation.
  dodoSubscriptionId String?      @unique
  /// Current local billing status.
  status             SubscriptionStatus @default(TRIALING)
  /// Current paid plan cadence.
  plan               SubscriptionPlan?
  /// Whether the subscription unlocks all agents or a selected subset.
  entitlementMode    SubscriptionEntitlementMode @default(CREW)
  /// Agents unlocked by this subscription. CREW subscriptions store all agents.
  selectedAgents     Agent[]       @default([])
  /// Checkout session waiting for provider confirmation.
  pendingCheckoutSessionId String?
  /// Pending paid plan cadence from latest checkout.
  pendingPlan        SubscriptionPlan?
  /// Pending entitlement mode from latest checkout.
  pendingEntitlementMode SubscriptionEntitlementMode?
  /// Pending selected agents from latest checkout.
  pendingSelectedAgents Agent[]    @default([])
  /// Pending Dodo product id from latest checkout.
  pendingProductId   String?
  /// Pending checkout creation timestamp.
  pendingCheckoutCreatedAt DateTime?
  /// Trial end timestamp.
  trialEndsAt        DateTime?
  /// Current paid period end timestamp.
  currentPeriodEnd   DateTime?
  /// Whether cancellation is scheduled for period end.
  cancelAtPeriodEnd  Boolean      @default(false)
  /// Subscription creation timestamp.
  createdAt          DateTime     @default(now())
  /// Subscription update timestamp.
  updatedAt          DateTime     @updatedAt

  @@map("subscription")
}

/// Dodo webhook event processing ledger for idempotency.
model BillingWebhookEvent {
  /// Dodo webhook event id.
  eventId        String   @id
  /// Dodo event type such as subscription.active.
  eventType      String
  /// Dodo subscription id if present.
  subscriptionId String?
  /// Owning organization id if resolved.
  organizationId String?
  /// Event processing timestamp.
  processedAt    DateTime @default(now())
  /// Compact processing result.
  result         String

  @@index([organizationId, processedAt])
  @@index([subscriptionId])
  @@map("billing_webhook_event")
}

/// User membership in an organization.
model Member {
  /// Membership row id.
  id             String       @id
  /// Organization id.
  organizationId String
  /// Organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// User id.
  userId         String
  /// User relation.
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Membership role such as owner or member.
  role           String       @default("member")
  /// Membership creation timestamp.
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId, role])
  @@index([organizationId, role])
  @@map("member")
}

/// Invitation to join an organization.
model Invitation {
  /// Invitation row id.
  id             String       @id
  /// Target organization id.
  organizationId String
  /// Target organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Invitee email address.
  email          String
  /// Invited role.
  role           String?
  /// Invitation status.
  status         String       @default("pending")
  /// Expiry timestamp.
  expiresAt      DateTime
  /// Creation timestamp.
  createdAt      DateTime     @default(now())
  /// Inviting user id.
  inviterId      String
  /// Inviting user relation.
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// Organization brand profile used by all agents.
model BrandKit {
  /// Brand kit id.
  id                  String    @id @default(uuid())
  /// Owning organization id.
  organizationId      String    @unique
  /// Company display name.
  company_name        String    @default("")
  /// Short company description.
  company_description String    @default("")
  /// Primary value proposition.
  value_proposition   String    @default("")
  /// Industry or market category.
  industry            String    @default("")
  /// Target audience description.
  target_audience     String    @default("")
  /// Brand voice guidance.
  brand_voice         String    @default("")
  /// Legacy public logo URL retained for older rows/clients.
  logo_url            String?
  /// R2 key for the logo asset.
  logo_key            String?
  /// Legacy public mascot URL retained for older rows/clients.
  mascot_url          String?
  /// R2 key for the mascot asset.
  mascot_key          String?
  /// Public URL for the organization's letterhead image (used in Lex document exports).
  letterhead_url      String?
  /// R2 key for the letterhead asset.
  letterhead_key      String?
  /// Brand color tokens.
  brand_colors        Json      @default("{}")
  /// Platform-specific tone guidance.
  platform_tones      Json      @default("{}")
  /// Known competitors from onboarding.
  competitors         Json      @default("[]")
  /// Differentiation notes.
  key_differentiators String    @default("")
  /// Company website URL.
  website_url         String    @default("")
  /// Optional business location.
  location            String?
  /// Raw crawled website text.
  crawled_content     String?
  /// AI or crawler summary of website content.
  crawled_summary     String?
  /// Last crawl timestamp.
  crawled_at          DateTime?
  /// URL/source used for the last crawl.
  crawl_source        String?
  /// Creation timestamp.
  createdAt           DateTime  @default(now())
  /// Update timestamp.
  updatedAt           DateTime  @updatedAt

  @@map("brand_kit")
}

/// Extra brand images selected for Maya generation.
model BrandImage {
  /// Brand image id.
  id             String   @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// R2 object key; public URL is derived from this key.
  key            String
  /// User-facing image name.
  name           String   @default("")
  /// Creation timestamp.
  createdAt      DateTime @default(now())
  /// Update timestamp.
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@map("brand_image")
}

/// Chat message history across agents.
model Message {
  /// Message id.
  id             String   @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// Message role, usually user or assistant.
  role           String   @default("user")
  /// Message text content.
  content        String
  /// Creation timestamp.
  createdAt      DateTime @default(now())
  /// Optional generated or attached image URL.
  imageUrl       String?
  /// Agent that owns this message.
  agent          Agent
  /// Token usage reported by the AI service.
  tokensUsed     Int      @default(0)
  /// Model identifier reported by the AI service.
  model          String?
  /// User id that initiated the message.
  userId         String?
  /// Structured action input/result metadata for cards.
  customInput    Json?

  @@index([agent, organizationId])
  @@index([organizationId, agent, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, role, createdAt])
  @@index([role, createdAt])
  @@index([agent, role, createdAt])
  @@map("message")
}

/// Per-agent long-term memory summary.
model AgentMemory {
  /// Memory row id.
  id               String       @id @default(uuid())
  /// Owning organization id.
  organizationId   String
  /// Agent this memory belongs to.
  agent            Agent
  /// Running conversation summary.
  runningSummary   String       @default("") @db.Text
  /// Durable facts extracted from conversations.
  longTermFacts    Json         @default("[]")
  /// Number of messages represented in the summary.
  messageCount     Int          @default(0)
  /// Last summarization timestamp.
  lastSummarizedAt DateTime?
  /// Creation timestamp.
  createdAt        DateTime     @default(now())
  /// Update timestamp.
  updatedAt        DateTime     @updatedAt
  /// Owning organization relation.
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agent])
  @@index([organizationId])
  @@map("agent_memory")
}

/// Organization-wide shared memory.
model OrgMemory {
  /// Memory row id.
  id             String       @id @default(uuid())
  /// Owning organization id.
  organizationId String       @unique
  /// Running organization summary.
  runningSummary String       @default("") @db.Text
  /// Durable organization-level facts.
  longTermFacts  Json         @default("[]")
  /// Shared cross-agent memory payload.
  sharedMemory   Json         @default("{}")
  /// Update timestamp.
  updatedAt      DateTime     @updatedAt
  /// Owning organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_memory")
}

/// Connected social account for publishing.
model SocialAccount {
  /// Social account id.
  id                   String         @id @default(uuid())
  /// Owning organization id.
  organizationId       String
  /// User who connected the account.
  userId               String
  /// Social platform.
  platform             SocialPlatform
  /// Provider-side account id.
  providerAccountId    String
  /// Provider-side account display name.
  accountName          String?
  /// Provider access token.
  accessToken          String
  /// Provider refresh token.
  refreshToken         String?
  /// Provider access token expiry.
  accessTokenExpiresAt DateTime?
  /// Provider OAuth scopes.
  scope                String?
  /// Provider-specific metadata.
  metadata             Json?
  /// Creation timestamp.
  createdAt            DateTime       @default(now())
  /// Update timestamp.
  updatedAt            DateTime       @updatedAt
  /// Posts published through this account.
  publishedPosts       PublishedPost[]

  @@unique([organizationId, platform, providerAccountId])
  @@index([organizationId, createdAt])
  @@index([organizationId, accessTokenExpiresAt])
  @@map("social_account")
}

/// Maya social post publication record.
model PublishedPost {
  /// Published post id.
  id              String         @id @default(uuid())
  /// Owning organization id.
  organizationId  String
  /// User who initiated publish.
  userId          String
  /// Connected account used for publishing.
  socialAccountId String?
  /// Connected account relation.
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  /// Target platform.
  platform        SocialPlatform
  /// Provider-side post id.
  platformPostId  String?
  /// Published caption/body.
  caption         String
  /// Hashtags included in the post.
  hashtags        String[]
  /// Optional image URL used in the post.
  imageUrl        String?
  /// Publish status such as pending, success, or failed.
  status          String         @default("pending")
  /// Publish error message when failed.
  error           String?
  /// Provider publish timestamp.
  publishedAt     DateTime?
  /// Local creation timestamp.
  createdAt       DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, status, publishedAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, platform, createdAt])
  @@index([socialAccountId])
  @@map("published_post")
}

/// Maya-generated idea saved to avoid repeats.
model MayaContentIdea {
  /// Idea id.
  id             String         @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// Platform this idea targets.
  platform       SocialPlatform
  /// Idea title.
  title          String
  /// Opening hook.
  hook           String
  /// Content format/type.
  contentType    String
  /// Creation timestamp.
  createdAt      DateTime       @default(now())
  /// Whether this idea has been used/published.
  isPublished    Boolean        @default(false)

  @@index([organizationId, platform, createdAt])
  @@index([organizationId, isPublished, createdAt])
  @@index([createdAt])
  @@map("maya_content_idea")
}

/// Sage saved SEO keyword bookmark.
model SageSavedKeyword {
  /// Saved keyword id.
  id                   String   @id @default(uuid())
  /// Owning organization id.
  organizationId       String
  /// Keyword phrase.
  keyword              String
  /// Search intent label.
  searchIntent         String   @default("")
  /// Estimated difficulty from 0 to 100.
  estimatedDifficulty  Int      @default(50)
  /// Relevance score from 0 to 1.
  relevanceScore       Float    @default(0.5)
  /// Human-readable search volume estimate.
  searchVolumeEstimate String?
  /// Suggested content format for the keyword.
  suggestedContentType String   @default("")
  /// Creation timestamp.
  createdAt            DateTime @default(now())

  @@unique([organizationId, keyword])
  @@index([organizationId, createdAt])
  @@index([estimatedDifficulty])
  @@map("sage_saved_keyword")
}

/// Lex uploaded source metadata; RAG chunks live in the AI service.
model LexSource {
  /// Source row id.
  id             String   @id @default(uuid())
  /// Owning organization id.
  organizationId String
  /// User who uploaded the source.
  userId         String
  /// Owning agent; currently always LEX.
  agent          Agent
  /// AI-service source id used for RAG queries.
  sourceId       String
  /// User-facing document name.
  name           String
  /// User-selected document type.
  type           String   @default("")
  /// AI-detected document type.
  typeDetected   String?
  /// R2 object key; public URL is derived from this key.
  r2Key          String
  /// Uploaded file size in bytes.
  sizeBytes      Int      @default(0)
  /// Parsed page count.
  pageCount      Int      @default(0)
  /// Number of RAG chunks created by the AI service.
  chunksCreated  Int      @default(0)
  /// AI-generated source summary.
  summary        String   @default("")
  /// AI-extracted key topics.
  keyTopics      String[] @default([])
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@unique([userId, sourceId])
  @@index([userId, organizationId, agent, createdAt])
  @@index([organizationId, agent, createdAt])
  @@map("lex_source")
}

/// Rex metric dataset parsed from uploads or ingest API.
model RexDataset {
  /// Dataset id.
  id             String   @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// User or integration owner id.
  userId         String
  /// Optional external/source id.
  sourceId       String?
  /// Dataset display name.
  name           String
  /// Canonical metric key, such as mrr.
  metricKey      String
  /// Metric unit, such as USD or users.
  unit           String?
  /// Period granularity label.
  period         String
  /// Dataset purpose, usually actual or forecast.
  purpose        String   @default("actual")
  /// Time-series points JSON.
  points         Json
  /// Parsed raw table and import metadata.
  meta           Json?
  /// Creation timestamp.
  createdAt      DateTime @default(now())
  /// Update timestamp.
  updatedAt      DateTime @updatedAt

  @@index([organizationId, updatedAt])
  @@index([organizationId, metricKey, purpose, updatedAt])
  @@map("rex_dataset")
}

/// Rex result card pinned to the Today/dashboard surface.
model RexPinnedCard {
  /// Pin id.
  id             String   @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// User who pinned the card.
  userId         String
  /// Card kind/type.
  kind           String
  /// Full card payload JSON.
  payload        Json
  /// Sort position in the pinned list.
  position       Int      @default(0)
  /// Whether the card is publicly shareable.
  isPublic       Boolean  @default(false)
  /// Public share token when sharing is enabled.
  shareToken     String?  @unique
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@index([organizationId, position])
  @@map("rex_pinned_card")
}

/// Rex organization-level settings.
model RexSettings {
  /// Owning organization id and primary key.
  organizationId         String   @id
  /// Whether weekly digest cron should include this org.
  weeklyDigestEnabled    Boolean  @default(true)
  /// Preferred digest timezone.
  weeklyDigestTimezone   String   @default("UTC")
  /// Email recipients for digest delivery.
  weeklyDigestRecipients String[]
  /// JSON alert rule configuration.
  alertRules             Json?
  /// Optional API key for metrics ingestion.
  ingestApiKey           String?  @unique
  /// Saved column mapping templates for uploads.
  columnMappingTemplates Json?
  /// Update timestamp.
  updatedAt              DateTime @updatedAt

  @@index([weeklyDigestEnabled])
  @@map("rex_settings")
}

/// Vega email follow-up reminder.
model VegaFollowUp {
  /// Follow-up id.
  id             String         @id @default(cuid())
  /// Gmail message id being followed up.
  emailId        String
  /// Email subject snapshot.
  emailSubject   String
  /// Sender email snapshot.
  senderEmail    String
  /// Due timestamp for the reminder.
  dueAt          DateTime
  /// Draft text to use when following up.
  draftText      String         @db.Text
  /// Follow-up lifecycle status.
  status         FollowUpStatus @default(PENDING)
  /// Owning organization id.
  organizationId String
  /// Creation timestamp.
  createdAt      DateTime       @default(now())
  /// Update timestamp.
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([status, dueAt])
  @@map("vega_follow_up")
}

/// Vega VIP contact used to prioritize inbox items.
model VIPContact {
  /// VIP contact id.
  id             String   @id @default(cuid())
  /// VIP email address.
  email          String
  /// Optional display name.
  name           String?
  /// Owning organization id.
  organizationId String
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@unique([email, organizationId])
  @@index([organizationId, createdAt])
  @@map("vip_contact")
}

/// Cached Vega briefing content for one day/type.
model VegaBriefingCache {
  /// Briefing id.
  id             String       @id @default(cuid())
  /// Calendar date in YYYY-MM-DD format.
  date           String
  /// Briefing cadence/type.
  type           BriefingType
  /// Full briefing payload JSON.
  content        Json
  /// Owning organization id.
  organizationId String
  /// Last generation timestamp.
  generatedAt    DateTime     @default(now())

  @@unique([date, type, organizationId])
  @@index([organizationId, date])
  @@map("vega_briefing_cache")
}

/// Vega custom inbox label.
model VegaLabel {
  /// Label id.
  id             String   @id @default(cuid())
  /// Label display name.
  name           String
  /// Hex color used in the UI.
  color          String   @default("#999999")
  /// Classification guidance used by Vega when choosing this label.
  rationale      String   @default("")
  /// Whether Vega should auto-draft replies for this label.
  autoReply      Boolean  @default(false)
  /// Owning organization id.
  organizationId String
  /// Creation timestamp.
  createdAt      DateTime @default(now())

  @@unique([name, organizationId])
  @@index([organizationId, createdAt])
  @@map("vega_label")
}

/// Latest processed Vega inbox snapshot for one organization.
model VegaInboxSnapshot {
  /// Snapshot id.
  id             String   @id @default(cuid())
  /// Owning organization id.
  organizationId String   @unique
  /// Processed inbox response cached for fast UI loads.
  snapshot       Json
  /// Cache timestamp used for TTL checks.
  cachedAt       DateTime @default(now())

  @@map("vega_inbox_snapshot")
}

// ─── Feedback / Voting System ────────────────────────────────────────────────

/// Status lifecycle of a user-submitted feedback post.
enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  LAUNCHED
  DECLINED
}

/// Categorisation tag on a feedback post.
enum FeedbackCategory {
  FEATURE_REQUEST
  BUG_REPORT
  INTEGRATION
  NEW_AGENT
  UX_IMPROVEMENT
  GENERAL
}

/// A feature request / bug report submitted by a user.
model FeedbackPost {
  /// Row id.
  id          String           @id @default(cuid())
  /// Short title supplied by the submitter.
  title       String
  /// Longer description supplied by the submitter.
  description String
  /// Categorisation tag.
  category    FeedbackCategory @default(GENERAL)
  /// Optional agent this feedback relates to.
  agentSlug   String?
  /// Current lifecycle status.
  status      FeedbackStatus   @default(NEW)
  /// Cached vote tally (incremented/decremented atomically).
  voteCount   Int              @default(0)
  /// Optional public-facing ETA shown on the roadmap.
  roadmapEta  String?
  /// Optional public admin reply shown to voters.
  adminReply  String?
  /// Optional internal-only admin note.
  adminNote   String?
  /// Whether the post has been merged into another.
  isMerged    Boolean          @default(false)
  /// Target post id when this post was merged.
  mergedIntoId String?
  /// Submitting user id.
  createdById String
  /// Submitting user relation.
  createdBy   User             @relation("FeedbackPostAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  /// Creation timestamp.
  createdAt   DateTime         @default(now())
  /// Last-updated timestamp.
  updatedAt   DateTime         @updatedAt
  /// Votes cast on this post.
  votes       FeedbackVote[]
  /// Comments on this post.
  comments    FeedbackComment[]

  @@index([status])
  @@index([category])
  @@index([agentSlug])
  @@index([createdById])
  @@index([voteCount])
  @@index([createdAt])
  @@map("feedback_post")
}

/// A single upvote by a user on a FeedbackPost.
model FeedbackVote {
  /// Row id.
  id         String       @id @default(cuid())
  /// Voting user id.
  userId     String
  /// Voting user relation.
  user       User         @relation("FeedbackVoteUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Target post id.
  feedbackId String
  /// Target post relation.
  feedback   FeedbackPost @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// Vote timestamp.
  createdAt  DateTime     @default(now())

  @@unique([userId, feedbackId])
  @@index([userId])
  @@index([feedbackId])
  @@map("feedback_vote")
}

/// A comment left by a user (or admin) on a FeedbackPost.
model FeedbackComment {
  /// Row id.
  id           String       @id @default(cuid())
  /// Comment text.
  content      String
  /// Commenting user id.
  userId       String
  /// Commenting user relation.
  user         User         @relation("FeedbackCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Parent post id.
  feedbackId   String
  /// Parent post relation.
  feedback     FeedbackPost @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// True when the comment was written by a platform admin.
  isAdminReply Boolean      @default(false)
  /// Creation timestamp.
  createdAt    DateTime     @default(now())

  @@index([feedbackId])
  @@index([userId])
  @@map("feedback_comment")
}

/// A potential upcoming agent shown on the voting page.
model UpcomingAgent {
  /// Row id.
  id          String              @id @default(cuid())
  /// Display name of the proposed agent.
  name        String
  /// One-line tagline shown in the card.
  tagline     String
  /// Optional longer description.
  description String?
  /// Optional emoji avatar.
  emoji       String?
  /// Optional brand colour (hex or Tailwind name).
  color       String?
  /// Sort order for display.
  order       Int                 @default(0)
  /// Whether the card is visible to users.
  isVisible   Boolean             @default(true)
  /// Cached vote tally.
  voteCount   Int                 @default(0)
  /// Creation timestamp.
  createdAt   DateTime            @default(now())
  /// Last-updated timestamp.
  updatedAt   DateTime            @updatedAt
  /// Votes cast on this agent.
  votes       UpcomingAgentVote[]

  @@index([isVisible, order])
  @@map("upcoming_agent")
}

/// A single upvote by a user on an UpcomingAgent.
model UpcomingAgentVote {
  /// Row id.
  id              String        @id @default(cuid())
  /// Voting user id.
  userId          String
  /// Voting user relation.
  user            User          @relation("UpcomingAgentVoteUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Target agent id.
  upcomingAgentId String
  /// Target agent relation.
  upcomingAgent   UpcomingAgent @relation(fields: [upcomingAgentId], references: [id], onDelete: Cascade)
  /// Vote timestamp.
  createdAt       DateTime      @default(now())

  @@unique([userId, upcomingAgentId])
  @@index([userId])
  @@index([upcomingAgentId])
  @@map("upcoming_agent_vote")
}

/// Pre-launch waitlist entry collected before product launch.
model WaitlistEntry {
  id        String    @id @default(cuid())
  email     String    @unique
  coupon    String?
  validTill DateTime?
  createdAt DateTime  @default(now())

  @@map("waitlist_entry")
}

/// Scheduled task owned by an organization — agent-automated or user-defined.
model Task {
  /// Task id.
  id             String       @id @default(cuid())
  /// Owning organization id.
  organizationId String
  /// Owning organization relation.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Display name.
  name           String
  /// Optional description.
  description    String?
  /// Whether this is an automated agent task or a user-defined general task.
  type           TaskType     @default(GENERAL)
  /// Agent responsible for running this task (AGENT type only).
  agent          Agent?
  /// CRON expression for recurrence (null means one-off).
  cronExpression String?
  /// IANA timezone for the cron schedule.
  timezone       String       @default("UTC")
  /// Whether the task is active and should run on schedule.
  isEnabled      Boolean      @default(true)
  /// True when seeded as a default task at org creation.
  isDefault      Boolean      @default(false)
  /// Extra configuration passed to the agent handler.
  payload        Json?
  /// Timestamp of the last run.
  lastRunAt      DateTime?
  /// Next scheduled run timestamp (computed from cron expression).
  nextRunAt      DateTime?
  /// Creation timestamp.
  createdAt      DateTime     @default(now())
  /// Update timestamp.
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([nextRunAt, isEnabled])
  @@map("task")
}

// ─── Expense Tracker ─────────────────────────────────────────────────────────

/// Expense category tag.
enum ExpenseCategory {
  FOOD
  TRAVEL
  ACCOMMODATION
  OFFICE
  ENTERTAINMENT
  UTILITIES
  SUBSCRIPTIONS
  EQUIPMENT
  OTHER
}

/// How the cost is divided among members.
enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

/// A named group of people sharing expenses (e.g. "Team Offsite", "Office").
model ExpenseGroup {
  /// Group id.
  id          String               @id @default(cuid())
  /// Display name.
  name        String
  /// Optional description.
  description String?
  /// User who created the group.
  createdById String
  /// Default currency for new expenses.
  currency    String               @default("USD")
  /// Creation timestamp.
  createdAt   DateTime             @default(now())
  /// Update timestamp.
  updatedAt   DateTime             @updatedAt
  /// Group members.
  members     ExpenseGroupMember[]
  /// Expenses in this group.
  expenses    Expense[]
  /// Settlements recorded in this group.
  settlements Settlement[]

  @@index([createdAt])
  @@map("expense_group")
}

/// Free-text named member of an ExpenseGroup (not linked to an app user account).
model ExpenseGroupMember {
  /// Row id.
  id       String       @id @default(cuid())
  /// Group this membership belongs to.
  groupId  String
  /// Display name for this member (free text).
  name     String
  /// When the member was added.
  joinedAt DateTime     @default(now())
  /// Group relation.
  group           ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Expenses paid by this member.
  expenses        Expense[]    @relation("ExpensePaidByMember")
  /// Splits this member is responsible for.
  expenseSplits   ExpenseSplit[]
  /// Settlements where this member is the payer.
  settlementsFrom Settlement[] @relation("SettlementFromMember")
  /// Settlements where this member is the receiver.
  settlementsTo   Settlement[] @relation("SettlementToMember")

  @@unique([groupId, name])
  @@index([groupId])
  @@map("expense_group_member")
}

/// A single expense logged in an ExpenseGroup.
model Expense {
  /// Expense id.
  id             String          @id @default(cuid())
  /// Owning group id.
  groupId        String
  /// Short description of the expense.
  title          String
  /// Amount in the original currency.
  amount         Float
  /// ISO-4217 currency code.
  currency       String          @default("USD")
  /// Amount converted to USD for balance calculations.
  amountUsd      Float
  /// Category tag.
  category       ExpenseCategory @default(OTHER)
  /// Member who paid for this expense.
  paidByMemberId String
  /// Optional receipt image/PDF URL (R2).
  receiptUrl     String?
  /// Optional free-text notes.
  notes          String?
  /// Date the expense occurred.
  date           DateTime
  /// Whether this expense recurs on a schedule.
  isRecurring    Boolean         @default(false)
  /// CRON expression for recurrence (null if not recurring).
  cronExpression String?
  /// Next scheduled recurrence timestamp.
  nextRunAt      DateTime?
  /// Creation timestamp.
  createdAt      DateTime        @default(now())
  /// Update timestamp.
  updatedAt      DateTime        @updatedAt
  /// Owning group relation.
  group          ExpenseGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Member who paid.
  paidByMember   ExpenseGroupMember @relation("ExpensePaidByMember", fields: [paidByMemberId], references: [id])
  /// How the cost is split among members.
  splits         ExpenseSplit[]

  @@index([groupId, date])
  @@index([groupId, category])
  @@index([paidByMemberId])
  @@index([isRecurring, nextRunAt])
  @@map("expense")
}

/// One member's share of a single Expense.
model ExpenseSplit {
  /// Row id.
  id             String             @id @default(cuid())
  /// Parent expense id.
  expenseId      String
  /// Group member responsible for this share.
  memberId       String
  /// How the split was computed.
  splitType      SplitType
  /// Share amount in the expense's original currency.
  shareAmount    Float
  /// Share amount converted to USD.
  shareAmountUsd Float
  /// Parent expense relation.
  expense        Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// Member relation.
  member         ExpenseGroupMember @relation(fields: [memberId], references: [id])

  @@unique([expenseId, memberId])
  @@index([expenseId])
  @@index([memberId])
  @@map("expense_split")
}

/// A recorded debt payment between two group members.
model Settlement {
  /// Settlement id.
  id          String       @id @default(cuid())
  /// Group this settlement belongs to.
  groupId     String
  /// Member who is paying.
  fromMemberId String
  /// Member who is receiving payment.
  toMemberId   String
  /// Amount paid in the settlement currency.
  amount      Float
  /// ISO-4217 currency code.
  currency    String       @default("USD")
  /// Amount converted to USD.
  amountUsd   Float
  /// Payment method (e.g. "UPI", "Cash", "Bank Transfer").
  method      String?
  /// Optional notes.
  notes       String?
  /// When the settlement was recorded.
  settledAt   DateTime     @default(now())
  /// Group relation.
  group        ExpenseGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Payer relation.
  fromMember   ExpenseGroupMember @relation("SettlementFromMember", fields: [fromMemberId], references: [id])
  /// Receiver relation.
  toMember     ExpenseGroupMember @relation("SettlementToMember", fields: [toMemberId], references: [id])

  @@index([groupId, settledAt])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@map("settlement")
}
