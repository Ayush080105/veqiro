// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Agent {
  MAYA
  SAGE
  LEX
  REX
  SCOUT
  VEGA
}

enum SocialPlatform {
  TWITTER
  LINKEDIN
  INSTAGRAM
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  onboarded   Boolean      @default(false)
  members     Member[]
  invitations Invitation[]
  subscriptionStatus     SubscriptionStatus?
  entitlementExpiresAt   DateTime?
  subscription           Subscription?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model BrandKit {
  id                  String    @id @default(uuid())
  organizationId      String    @unique
  company_name        String    @default("")
  company_description String    @default("")
  value_proposition   String    @default("")
  industry            String    @default("")
  target_audience     String    @default("")
  brand_voice         String    @default("")
  logo_url            String?
  logo_key            String?
  mascot_url          String?
  mascot_key          String?
  brand_colors        Json      @default("{}")
  platform_tones      Json      @default("{}")
  competitors         Json      @default("[]")
  key_differentiators String    @default("")
  website_url         String    @default("")
  crawled_content     String?
  crawled_summary     String?
  crawled_at          DateTime?
  crawl_source        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId])
  @@map("brand_kit")
}

model Message{
  id     String @id @default(uuid())
  organizationId  String
  role String @default("user")
  content String
  createdAt DateTime @default(now())
  imageUrl String?
  agent Agent
  tokensUsed Int @default(0)
  model String?
  userId String?
  customInput Json?

  @@index([agent,organizationId])
  @@map("message")
}

model SocialAccount {
  id                   String         @id @default(uuid())
  organizationId       String
  userId               String
  platform             SocialPlatform
  providerAccountId    String
  accountName          String?
  accessToken          String
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  scope                String?
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  publishedPosts PublishedPost[]

  @@unique([organizationId, platform, providerAccountId])
  @@index([organizationId])
  @@map("social_account")
}

model PublishedPost {
  id              String         @id @default(uuid())
  organizationId  String
  userId          String
  socialAccountId String
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  platformPostId  String?
  caption         String
  hashtags        String[]
  imageUrl        String?
  status          String         @default("pending")
  error           String?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())

  @@index([organizationId])
  @@index([socialAccountId])
  @@map("published_post")
}

model CompetitorWatch {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  url            String
  latestHash     String?
  lastScannedAt  DateTime?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, url])
  @@index([organizationId])
  @@map("competitor_watch")
}

model SavedKeyword {
  id                   String   @id @default(uuid())
  organizationId       String
  keyword              String
  searchIntent         String   @default("")
  estimatedDifficulty  Int      @default(50)
  relevanceScore       Float    @default(0.5)
  searchVolumeEstimate String?
  suggestedContentType String   @default("")
  createdAt            DateTime @default(now())

  @@unique([organizationId, keyword])
  @@index([organizationId])
  @@map("saved_keyword")
}

model Source {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  agent          Agent
  sourceId       String
  name           String
  type           String   @default("")
  typeDetected   String?
  r2Key          String
  r2Url          String
  sizeBytes      Int      @default(0)
  pageCount      Int      @default(0)
  chunksCreated  Int      @default(0)
  summary        String   @default("")
  keyTopics      String[] @default([])
  createdAt      DateTime @default(now())

  @@unique([userId, sourceId])
  @@index([organizationId, agent])
  @@index([userId, agent])
  @@map("source")
}

model RexDataset {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  sourceId       String?
  name           String
  metricKey      String
  unit           String?
  period         String
  points         Json
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, metricKey])
  @@map("rex_dataset")
}

model RexPinnedCard {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  payload        Json
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, position])
  @@map("rex_pinned_card")
}

model RexSettings {
  organizationId          String   @id
  weeklyDigestEnabled     Boolean  @default(true)
  weeklyDigestTimezone    String   @default("UTC")
  weeklyDigestRecipients  String[]
  updatedAt               DateTime @updatedAt

  @@map("rex_settings")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

model Subscription {
  id                    String              @id @default(cuid())
  organizationId        String              @unique
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dodoCustomerId        String              @unique
  dodoSubscriptionId    String?             @unique

  status                SubscriptionStatus  @default(TRIALING)
  plan                  SubscriptionPlan?

  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean             @default(false)

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("subscription")
}

enum FollowUpStatus {
  PENDING
  SENT
  CANCELLED
  OVERDUE
}

enum BriefingType {
  MORNING
  EVENING
  WEEKLY
}

model VegaFollowUp {
  id             String         @id @default(cuid())
  emailId        String
  emailSubject   String
  senderEmail    String
  dueAt          DateTime
  draftText      String         @db.Text
  status         FollowUpStatus @default(PENDING)
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([dueAt])
  @@map("vega_follow_up")
}

model VIPContact {
  id             String   @id @default(cuid())
  email          String
  name           String?
  organizationId String
  createdAt      DateTime @default(now())

  @@unique([email, organizationId])
  @@index([organizationId])
  @@map("vip_contact")
}

model VegaBriefingCache {
  id             String       @id @default(cuid())
  date           String
  type           BriefingType
  content        Json
  organizationId String
  generatedAt    DateTime     @default(now())

  @@unique([date, type, organizationId])
  @@index([organizationId, date])
  @@map("vega_briefing_cache")
}