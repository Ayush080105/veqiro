{
    "compilerOptions": {
      "target": "ES2020",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "outDir": "./dist",
      "esModuleInterop": true,
      "jsx": "react-jsx",
      "strict": true,
      "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
  }